<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>동의 요청</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/recipient-request.css"></head><body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/>

<div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">CONSENT REQUEST</p><h1>동의 요청</h1><p>대상자와 발행 템플릿을 연결하고 확정·링크 발급·만료 상태를 관리합니다.</p></div><a class="primary-button" href="${pageContext.request.contextPath}/admin/requests/new">요청 생성</a></div><section class="work-panel"><form method="get" class="request-filter"><label for="status">상태</label><select id="status" name="status"><option value="">전체</option><c:forEach var="state" items="${['DRAFT','READY','ACTIVE','COMPLETED','EXPIRED','CANCELLED']}"><option value="${state}" ${selectedStatus == state ? 'selected' : ''}>${state}</option></c:forEach></select><button class="secondary-button">조회</button></form><div class="table-scroll"><table class="data-table"><thead><tr><th>요청번호</th><th>상태</th><th>만료일시</th><th>생성일시</th></tr></thead><tbody><c:forEach var="request" items="${requests}"><tr><td><a href="${pageContext.request.contextPath}/admin/requests/${request.requestId()}"><c:out value="${request.requestCode()}"/></a></td><td><span class="request-state state-${request.status()}"><c:out value="${request.status()}"/></span></td><td><c:out value="${request.expiresAt()}"/></td><td><c:out value="${request.createdAt()}"/></td></tr></c:forEach><c:if test="${empty requests}"><tr><td colspan="4">동의 요청이 없습니다.</td></tr></c:if></tbody></table></div><jsp:include page="/WEB-INF/jsp/fragments/admin/pagination.jsp"/></section></main></div></body></html>
