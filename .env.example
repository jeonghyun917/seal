# Copy values into the IDE run configuration or OS environment.
# Do not rename this file to a tracked file containing real secrets.

SPRING_PROFILES_ACTIVE=local
SEAL_SERVER_PORT=9090

SEAL_DB_URL=jdbc:postgresql://localhost:5432/seal_dev?currentSchema=seal
SEAL_DB_USERNAME=seal_app
SEAL_DB_PASSWORD=

SEAL_ADMIN_MAX_LOGIN_FAILURES=5
SEAL_ADMIN_LOCK_DURATION=15m

# Used once only when seal.admin_user is empty. Remove after the first login.
SEAL_BOOTSTRAP_ADMIN_ID=seal-admin
SEAL_BOOTSTRAP_ADMIN_NAME=최초 관리자
SEAL_BOOTSTRAP_ADMIN_PASSWORD=

SEAL_MAIL_ENABLED=false
SEAL_SMTP_HOST=relay.govkorea.com
SEAL_SMTP_PORT=465
SEAL_MAIL_FROM_ADDRESS=no-reply@arte.or.kr
SEAL_MAIL_FROM_NAME=개인정보 동의 안내
