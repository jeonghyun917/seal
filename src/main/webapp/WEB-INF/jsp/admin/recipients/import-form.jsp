<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>대상자 Excel 반입</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"></head><body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">RECIPIENT IMPORT</p><h1>대상자 Excel 반입</h1><p>.xlsx 5MB 이하, 최대 1,000명까지 검증 후 반입합니다.</p></div><a class="secondary-button" href="${pageContext.request.contextPath}/admin/recipients/import/template.xlsx">양식 다운로드</a></div><c:if test="${not empty error}"><p class="alert alert-error" role="alert"><c:out value="${error}"/></p></c:if><section class="work-panel"><c:if test="${clamAvDisabled}"><p class="alert">로컬 개발환경에서는 ClamAV 검사가 비활성화되어 있습니다. 운영 활성화 시 검사 실패 파일은 반입되지 않습니다.</p></c:if><form method="post" enctype="multipart/form-data" class="data-form"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><div class="form-field"><label for="organizationUnitId">소속 조직</label><select id="organizationUnitId" name="organizationUnitId" required><option value="">선택</option><c:forEach var="org" items="${organizations}"><option value="${org.organizationUnitId()}" ${organizationUnitId == org.organizationUnitId() ? 'selected' : ''}><c:out value="${org.organizationName()}"/></option></c:forEach></select></div><div class="form-field"><label for="collectionBasis">수집·반입 근거</label><textarea id="collectionBasis" name="collectionBasis" minlength="5" maxlength="500" required><c:out value="${collectionBasis}"/></textarea></div><div class="form-field"><label for="file">Excel 파일</label><input id="file" name="file" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required></div><div class="form-actions"><a class="secondary-button" href="${pageContext.request.contextPath}/admin/recipients">취소</a><button class="primary-button">검증하기</button></div></form></section></main></div></body></html>
