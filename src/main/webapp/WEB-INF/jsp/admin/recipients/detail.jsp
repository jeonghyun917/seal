<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>대상자 상세</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"></head>
<body class="admin-body"><header class="admin-header"><a class="admin-brand" href="${pageContext.request.contextPath}/admin"><span>ARTE</span><strong>개인정보 전자동의·증적 관리시스템</strong></a></header><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">RECIPIENT DETAIL</p><h1><c:out value="${recipient.maskedName()}"/></h1><p>관리자 화면에서는 개인정보 원문을 다시 표시하지 않습니다.</p></div><a class="primary-button" href="${pageContext.request.contextPath}/admin/recipients/${recipient.recipientId()}/edit">수정</a></div>
<section class="work-panel"><dl class="detail-list"><div><dt>이름</dt><dd><c:out value="${recipient.maskedName()}"/></dd></div><div><dt>이메일</dt><dd><c:out value="${recipient.maskedEmail()}"/></dd></div><div><dt>수집 근거</dt><dd><c:out value="${recipient.collectionBasis()}"/></dd></div><div><dt>상태</dt><dd><c:out value="${recipient.status()}"/></dd></div></dl></section>
<section class="work-panel action-panel"><form method="post" action="${pageContext.request.contextPath}/admin/recipients/${recipient.recipientId()}/status"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="versionNo" value="${recipient.versionNo()}"><input type="hidden" name="status" value="${recipient.status() == 'ACTIVE' ? 'INACTIVE' : 'ACTIVE'}"><button class="secondary-button" type="submit">${recipient.status() == 'ACTIVE' ? '비활성화' : '재활성화'}</button></form></section></main></body></html>
