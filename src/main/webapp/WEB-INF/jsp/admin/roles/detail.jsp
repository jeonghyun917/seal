<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>역할 상세</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"></head>
<body class="admin-body"><header class="admin-header"><a class="admin-brand" href="${pageContext.request.contextPath}/admin"><span>ARTE</span><strong>개인정보 전자동의·증적 관리시스템</strong></a></header><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">ROLE DETAIL</p><h1><c:out value="${role.roleName()}"/></h1><p><c:out value="${role.roleCode()}"/></p></div><div class="form-actions"><a class="secondary-button" href="${pageContext.request.contextPath}/admin/roles">목록</a><a class="primary-button" href="${pageContext.request.contextPath}/admin/roles/${role.roleId()}/edit">수정</a></div></div>
<c:if test="${param.created != null}"><p class="alert alert-success">역할을 생성했습니다.</p></c:if><c:if test="${param.updated != null}"><p class="alert alert-success">역할과 권한을 변경했습니다.</p></c:if>
<section class="work-panel"><h2>기본 정보</h2><dl class="detail-list"><div><dt>역할코드</dt><dd><c:out value="${role.roleCode()}"/></dd></div><div><dt>구분</dt><dd>${role.systemRole() ? '시스템 역할' : '사용자 정의 역할'}</dd></div><div><dt>상태</dt><dd>${role.active() ? '활성' : '비활성'}</dd></div></dl></section>
<section class="work-panel action-panel"><h2>부여된 권한</h2><div class="permission-list"><c:forEach var="permission" items="${permissions}"><c:if test="${assignedPermissionIds.contains(permission.permissionId())}"><article><strong><c:out value="${permission.permissionName()}"/></strong><span><c:out value="${permission.permissionCode()}"/></span><p><c:out value="${permission.description()}"/></p></article></c:if></c:forEach></div></section></main></body></html>
