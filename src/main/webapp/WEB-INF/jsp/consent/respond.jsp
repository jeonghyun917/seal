<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="referrer" content="no-referrer"><title><c:out value="${document.title()}"/></title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/public-consent.css"></head><body><main class="consent-shell"><div class="public-brand">ARTE · <c:out value="${document.institution()}"/></div><section class="consent-card"><p class="kicker">CONSENT ITEMS</p><h1><c:out value="${document.title()}"/></h1><div class="notice-html"><c:out value="${document.introductionHtml()}" escapeXml="false"/></div><dl class="summary"><dt>개인정보 이용 업무</dt><dd><c:out value="${document.processingActivityName()}"/></dd><dt>개인정보 이용 목적</dt><dd><c:out value="${document.processingPurpose()}"/></dd><dt>보유기간</dt><dd><c:out value="${document.retentionDisplayText()}"/></dd></dl><form method="post"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><c:forEach var="item" items="${document.items()}"><fieldset class="decision-card"><legend><span class="badge">${item.required() ? '필수' : '선택'}</span> <c:out value="${item.title()}"/></legend><p><strong>목적</strong> <c:out value="${item.purpose()}"/></p><p><strong>보유기간</strong> <c:out value="${item.retentionText()}"/></p><dl class="item-details"><dt>개인정보 항목</dt><dd><c:out value="${item.personalDataItems()}"/></dd><c:if test="${not empty item.thirdPartyRecipient()}"><dt>제공받는 자</dt><dd><c:out value="${item.thirdPartyRecipient()}"/></dd></c:if></dl><p><c:out value="${item.refusalNotice()}"/></p><div class="choices"><label><input type="radio" name="decision_${item.itemId()}" value="AGREE" required ${decisions[item.itemId()] == 'AGREE' ? 'checked' : ''}> 동의</label><label><input type="radio" name="decision_${item.itemId()}" value="DISAGREE" required ${decisions[item.itemId()] == 'DISAGREE' ? 'checked' : ''}> 미동의</label></div></fieldset></c:forEach><p class="withdrawal"><c:out value="${document.withdrawalNotice()}"/></p><button class="primary">선택 내용 확인</button></form></section></main></body></html>
