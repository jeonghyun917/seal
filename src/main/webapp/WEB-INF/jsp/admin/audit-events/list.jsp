<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>감사 이력 | 개인정보 전자동의·증적 관리시스템</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"></head>
<body class="admin-body"><header class="admin-header"><a class="admin-brand" href="${pageContext.request.contextPath}/admin"><span>ARTE</span><strong>개인정보 전자동의·증적 관리시스템</strong></a><div class="user-actions"><span><strong><c:out value="${administrator.displayName()}"/></strong> 님</span></div></header>
<div class="admin-layout"><nav class="admin-nav" aria-label="관리자 주 메뉴"><a href="${pageContext.request.contextPath}/admin">대시보드</a><span class="nav-group">기준정보</span><a href="${pageContext.request.contextPath}/admin/organizations">조직 관리</a><a href="${pageContext.request.contextPath}/admin/retention-policies">보유정책</a><a href="${pageContext.request.contextPath}/admin/processing-activities">처리업무</a><span class="nav-group">시스템 관리</span><a href="${pageContext.request.contextPath}/admin/users">관리자 계정</a><a href="${pageContext.request.contextPath}/admin/roles">역할·권한</a><a class="active" aria-current="page" href="${pageContext.request.contextPath}/admin/audit-events">감사 이력</a></nav>
<main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">AUDIT TRAIL</p><h1>감사 이력</h1><p>조직 범위 안에서 최근 7일 동안 발생한 중요 이벤트를 조회합니다.</p></div><span class="status-badge">최대 200건</span></div>
<section class="work-panel" aria-labelledby="audit-list-title"><h2 id="audit-list-title">최근 이벤트</h2><div class="table-scroll"><table class="data-table"><thead><tr><th>발생시각</th><th>행위자</th><th>작업</th><th>대상</th><th>결과</th><th>사유</th></tr></thead><tbody>
<c:forEach var="event" items="${events}"><tr><td><c:out value="${event.occurredAt()}"/></td><td><c:out value="${event.actorDisplayName()}" default="${event.actorType()}"/></td><td><c:out value="${event.actionCode()}"/></td><td><c:out value="${event.targetType()}"/> <c:out value="${event.targetId()}"/></td><td><span class="state-text ${event.result() == 'SUCCESS' ? 'ready' : 'pending'}"><c:out value="${event.result()}"/></span></td><td><c:out value="${event.reasonCode()}" default="-"/></td></tr></c:forEach>
<c:if test="${empty events}"><tr><td colspan="6">조회 기간에 감사 이벤트가 없습니다.</td></tr></c:if></tbody></table></div></section></main></div></body></html>
