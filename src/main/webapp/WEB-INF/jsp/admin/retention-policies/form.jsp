<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>보유정책 등록</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"></head>
<body class="admin-body"><header class="admin-header"><a class="admin-brand" href="${pageContext.request.contextPath}/admin"><span>ARTE</span><strong>개인정보 전자동의·증적 관리시스템</strong></a></header><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">NEW RETENTION POLICY</p><h1>보유정책 등록</h1><p>정책 기본정보와 첫 번째 초안 버전을 함께 생성합니다.</p></div></div>
<section class="work-panel"><form:form method="post" action="${pageContext.request.contextPath}/admin/retention-policies" modelAttribute="policyForm" cssClass="data-form"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
<div class="form-field"><form:label path="policyCode">정책코드</form:label><form:input path="policyCode" maxlength="30" placeholder="예: EDU-RET-01"/><form:errors path="policyCode" cssClass="field-error"/></div>
<div class="form-field"><form:label path="policyName">정책명</form:label><form:input path="policyName" maxlength="100"/><form:errors path="policyName" cssClass="field-error"/></div>
<div class="form-field"><form:label path="ownerOrganizationUnitId">소유 조직</form:label><form:select path="ownerOrganizationUnitId"><form:option value="" label="선택"/><c:forEach var="organization" items="${organizations}"><form:option value="${organization.organizationUnitId()}" label="${organization.organizationName()}"/></c:forEach></form:select><form:errors path="ownerOrganizationUnitId" cssClass="field-error"/></div>
<div class="form-field"><form:label path="startEvent">기산 이벤트</form:label><form:select path="startEvent"><form:option value="" label="선택"/><form:options items="${startEvents}"/></form:select><form:errors path="startEvent" cssClass="field-error"/></div>
<div class="form-field"><form:label path="periodValue">보유기간 값</form:label><form:input path="periodValue" type="number" min="1" max="100"/><form:errors path="periodValue" cssClass="field-error"/></div>
<div class="form-field"><form:label path="periodUnit">보유기간 단위</form:label><form:select path="periodUnit"><form:options items="${periodUnits}"/></form:select></div>
<div class="form-field"><form:label path="gracePeriodDays">파기 유예일</form:label><form:input path="gracePeriodDays" type="number" min="0" max="365"/><form:errors path="gracePeriodDays" cssClass="field-error"/></div>
<div class="form-field"><form:label path="destructionMethod">파기 방식</form:label><form:select path="destructionMethod"><form:options items="${destructionMethods}"/></form:select></div>
<div class="form-actions"><a class="secondary-button" href="${pageContext.request.contextPath}/admin/retention-policies">취소</a><button class="primary-button" type="submit">초안 생성</button></div></form:form></section></main></body></html>
