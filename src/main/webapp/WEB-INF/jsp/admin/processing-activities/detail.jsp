<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>처리업무 상세</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"></head><body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">PROCESSING ACTIVITY DETAIL</p><h1><c:out value="${activity.activityName()}"/></h1><p><c:out value="${activity.activityCode()}"/> · <c:out value="${activity.organizationName()}"/></p></div><a class="secondary-button" href="${pageContext.request.contextPath}/admin/processing-activities">목록</a></div><c:if test="${param.created != null}"><p class="alert alert-success">처리업무 초안을 생성했습니다.</p></c:if><c:if test="${param.approved != null}"><p class="alert alert-success">처리업무 버전을 승인했습니다.</p></c:if>
<section class="work-panel"><h2>버전 이력</h2><c:forEach var="v" items="${versions}"><article class="version-card"><div class="version-heading"><strong>버전 ${v.versionNumber()} · ${v.workflowStatus()}</strong><span>작성자 <c:out value="${v.createdByName()}"/></span></div><dl class="detail-list"><div><dt>처리 근거</dt><dd>${v.legalBasisType()} · <c:out value="${v.legalBasisDetail()}"/></dd></div><div><dt>보유정책</dt><dd><c:out value="${v.retentionPolicyName()}"/> v${v.retentionVersionNumber()}</dd></div><div><dt>처리 목적</dt><dd><c:out value="${v.processingPurpose()}"/></dd></div></dl><h3>개인정보 항목</h3><ul><c:forEach var="item" items="${dataItems}"><c:if test="${item.processingActivityVersionId().equals(v.processingActivityVersionId())}"><li><strong><c:out value="${item.itemName()}"/></strong> — <c:out value="${item.necessityReason()}"/> (${item.required() ? '필수' : '선택'})</li></c:if></c:forEach></ul><c:if test="${not empty v.rejectionComment()}"><p class="alert alert-error"><c:out value="${v.rejectionComment()}"/></p></c:if><div class="form-actions"><c:if test="${v.workflowStatus() == 'DRAFT'}"><form method="post" action="${pageContext.request.contextPath}/admin/processing-activities/${activity.processingActivityId()}/versions/${v.processingActivityVersionId()}/request-review"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="primary-button">검토 요청</button></form></c:if><c:if test="${v.workflowStatus() == 'REVIEW_REQUESTED'}"><form method="post" action="${pageContext.request.contextPath}/admin/processing-activities/${activity.processingActivityId()}/versions/${v.processingActivityVersionId()}/approve"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="primary-button">승인</button></form><form class="reject-form" method="post" action="${pageContext.request.contextPath}/admin/processing-activities/${activity.processingActivityId()}/versions/${v.processingActivityVersionId()}/reject"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input name="comment" required maxlength="1000" placeholder="반려 의견"><button class="secondary-button">반려</button></form></c:if></div></article></c:forEach></section></main></div></body></html>
