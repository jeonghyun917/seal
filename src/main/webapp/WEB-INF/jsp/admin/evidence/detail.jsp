<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>증적 상세</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"></head><body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">EVIDENCE DETAIL</p><h1>증적 패키지 상세</h1><p><c:out value="${item.packageId()}"/></p></div><a class="secondary-button" href="${pageContext.request.contextPath}/admin/evidence">목록</a></div><c:if test="${not empty verificationResult}"><p class="alert">무결성 검증 결과: <strong><c:out value="${verificationResult}"/></strong></p></c:if><section class="work-panel"><dl><dt>상태</dt><dd><c:out value="${item.status()}"/></dd><dt>매니페스트 SHA-256</dt><dd><c:out value="${item.manifestSha256()}"/></dd><dt>완료시각</dt><dd><c:out value="${item.finalizedAt()}"/></dd></dl><div class="table-scroll"><table class="data-table"><thead><tr><th>종류</th><th>파일</th><th>크기</th><th>SHA-256</th></tr></thead><tbody><c:forEach var="file" items="${item.files()}"><tr><td><c:out value="${file.type()}"/></td><td><c:out value="${file.fileName()}"/></td><td><c:out value="${file.size()}"/></td><td><c:out value="${file.sha256().substring(0,12)}"/>…</td></tr></c:forEach></tbody></table></div><div class="form-actions"><sec:authorize access="hasAuthority('EVIDENCE_VERIFY')"><form method="post" action="${pageContext.request.contextPath}/admin/evidence/${item.packageId()}/verify"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="secondary-button">무결성 검증</button></form></sec:authorize><sec:authorize access="hasAuthority('EVIDENCE_DOWNLOAD')"><a class="primary-button" href="${pageContext.request.contextPath}/admin/evidence/${item.packageId()}/download">ZIP 다운로드</a></sec:authorize><c:if test="${item.status() == 'FAILED'}"><sec:authorize access="hasAuthority('EVIDENCE_GENERATE')"><form method="post" action="${pageContext.request.contextPath}/admin/evidence/${item.packageId()}/retry"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="secondary-button">재생성</button></form></sec:authorize></c:if></div></section></main></div></body></html>
