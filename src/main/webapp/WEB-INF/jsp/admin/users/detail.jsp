<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>관리자 상세</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"></head><body class="admin-body"><header class="admin-header"><a class="admin-brand" href="${pageContext.request.contextPath}/admin"><span>ARTE</span><strong>개인정보 전자동의·증적 관리시스템</strong></a></header><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">ADMINISTRATOR DETAIL</p><h1><c:out value="${user.displayName()}"/></h1><p><c:out value="${user.loginId()}"/> · <c:out value="${user.organizationName()}"/></p></div><div class="form-actions"><a class="secondary-button" href="${pageContext.request.contextPath}/admin/users">목록</a><a class="primary-button" href="${pageContext.request.contextPath}/admin/users/${user.adminUserId()}/edit">수정</a></div></div>
<c:if test="${param.created != null or param.updated != null or param.unlocked != null or param.passwordReset != null}"><p class="alert alert-success">관리자 계정 변경을 완료했습니다.</p></c:if>
<section class="work-panel"><h2>계정 상태</h2><dl class="detail-list"><div><dt>상태</dt><dd><c:out value="${user.accountStatus()}"/></dd></div><div><dt>로그인 실패</dt><dd><c:out value="${user.consecutiveFailures()}"/>회</dd></div><div><dt>잠금 종료</dt><dd><c:out value="${user.lockedUntil()}" default="-"/></dd></div><div><dt>비밀번호 변경 필요</dt><dd>${user.mustChangePassword() ? '예' : '아니요'}</dd></div></dl></section>
<section class="work-panel action-panel"><h2>보안 작업</h2><div class="form-actions"><form method="post" action="${pageContext.request.contextPath}/admin/users/${user.adminUserId()}/unlock"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="secondary-button" type="submit">잠금 해제</button></form><form class="reject-form" method="post" action="${pageContext.request.contextPath}/admin/users/${user.adminUserId()}/reset-password"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label>새 임시 비밀번호 <input type="password" name="temporaryPassword" required minlength="12" maxlength="128" autocomplete="new-password"></label><button class="primary-button" type="submit">비밀번호 초기화</button></form></div></section></main></body></html>
