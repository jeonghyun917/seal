<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>${editing ? '초안 편집' : '템플릿 등록'} | 개인정보 전자동의 관리시스템</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/template.css" defer><script src="${pageContext.request.contextPath}/resources/js/template-form.js" defer></script></head>
<body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main">
<div class="page-heading-row"><div><p class="section-kicker">TEMPLATE EDITOR</p><h1>${editing ? '동의서 초안 편집' : '동의서 템플릿 등록'}</h1><p>보유기간과 개인정보 항목은 승인된 처리업무 원본을 기준으로 서버에서 다시 검증합니다.</p></div></div>
<c:set var="formAction" value="${editing ? pageContext.request.contextPath.concat('/admin/templates/').concat(templateId).concat('/versions/').concat(versionId) : pageContext.request.contextPath.concat('/admin/templates')}"/>
<form:form cssClass="template-editor" modelAttribute="templateForm" method="post" action="${formAction}"><form:hidden path="templateVersionNo"/><form:hidden path="contentVersionNo"/>
<section class="work-panel"><h2>기본 정보</h2><div class="template-grid"><label>템플릿 코드<form:input path="templateCode" readonly="${editing}"/><form:errors path="templateCode" cssClass="field-error"/></label><label>관리 명칭<form:input path="templateName"/><form:errors path="templateName" cssClass="field-error"/></label></div>
<fieldset><legend>승인 처리업무</legend><c:choose><c:when test="${editing}"><form:hidden path="processingActivityVersionId"/><p class="read-only-value"><c:out value="${templateForm.processingActivityVersionId}"/></p></c:when><c:otherwise><div class="activity-options"><c:forEach var="activity" items="${activities}"><label class="activity-card"><form:radiobutton path="processingActivityVersionId" value="${activity.versionId()}"/><span><strong><c:out value="${activity.activityName()}"/></strong><small><c:out value="${activity.processingPurpose()}"/> · <c:out value="${activity.retentionDisplayText()}"/></small></span></label></c:forEach></div><form:errors path="processingActivityVersionId" cssClass="field-error"/></c:otherwise></c:choose></fieldset></section>
<section class="work-panel"><h2>안내문</h2><label>동의서 제목<form:input path="title"/><form:errors path="title" cssClass="field-error"/></label><label>HTML 안내문<form:textarea path="introductionHtml" rows="7"/><small>허용 태그: p, br, ul, ol, li, strong, em, h3, h4</small><form:errors path="introductionHtml" cssClass="field-error"/></label></section>
<section class="work-panel"><div class="panel-title-row"><div><h2>동의 결정 항목</h2><p>각 항목마다 정보주체가 동의 또는 미동의를 선택합니다.</p></div><button class="secondary-button" id="add-consent-item" type="button">항목 추가</button></div><div id="consent-items"><c:forEach var="item" items="${templateForm.items}" varStatus="status"><article class="consent-item-card" data-consent-item><div class="item-card-head"><strong>동의 항목 <span data-item-number>${status.index + 1}</span></strong><button type="button" class="text-button" data-remove-item>삭제</button></div><div class="template-grid"><label>항목 코드<form:input path="items[${status.index}].code"/></label><label>유형<form:select path="items[${status.index}].type"><form:options items="${itemTypes}"/></form:select></label><label>제목<form:input path="items[${status.index}].title"/></label><label class="check-label"><form:checkbox path="items[${status.index}].required"/> 필수 동의</label></div><label>처리 목적<form:textarea path="items[${status.index}].purpose" rows="2"/></label><label>보유기간 안내<form:input path="items[${status.index}].retentionText"/></label><label>거부권 안내<form:textarea path="items[${status.index}].refusalNotice" rows="2"/></label><label>제공받는 자(제3자 제공만)<form:input path="items[${status.index}].thirdPartyRecipient"/></label><fieldset><legend>개인정보 항목</legend><c:forEach var="activity" items="${activities}"><c:forEach var="dataItem" items="${activity.dataItems()}"><label class="check-label"><form:checkbox path="items[${status.index}].processingDataItemIds" value="${dataItem.processingDataItemId()}"/><c:out value="${dataItem.itemName()}"/></label></c:forEach></c:forEach></fieldset><form:errors path="items[${status.index}].*" cssClass="field-error"/></article></c:forEach></div><form:errors path="items" cssClass="field-error"/></section>
<div class="form-actions"><a class="secondary-button" href="${pageContext.request.contextPath}/admin/templates">취소</a><button class="primary-button" type="submit">${editing ? '초안 저장' : '템플릿 등록'}</button></div></form:form>
<template id="consent-item-template"><article class="consent-item-card" data-consent-item><div class="item-card-head"><strong>동의 항목 <span data-item-number></span></strong><button type="button" class="text-button" data-remove-item>삭제</button></div><div class="template-grid"><label>항목 코드<input name="items[__INDEX__].code"></label><label>유형<select name="items[__INDEX__].type"><option value="COLLECTION_USE">COLLECTION_USE</option><option value="THIRD_PARTY_PROVISION">THIRD_PARTY_PROVISION</option><option value="OPTIONAL">OPTIONAL</option></select></label><label>제목<input name="items[__INDEX__].title"></label><label class="check-label"><input type="checkbox" name="items[__INDEX__].required" value="true"> 필수 동의</label></div><label>처리 목적<textarea name="items[__INDEX__].purpose" rows="2"></textarea></label><label>보유기간 안내<input name="items[__INDEX__].retentionText" value="보유정책에서 자동 적용"></label><label>거부권 안내<textarea name="items[__INDEX__].refusalNotice" rows="2"></textarea></label><label>제공받는 자<input name="items[__INDEX__].thirdPartyRecipient"></label><fieldset><legend>개인정보 항목</legend><c:forEach var="activity" items="${activities}"><c:forEach var="dataItem" items="${activity.dataItems()}"><label class="check-label"><input type="checkbox" name="items[__INDEX__].processingDataItemIds" value="${dataItem.processingDataItemId()}"><c:out value="${dataItem.itemName()}"/></label></c:forEach></c:forEach></fieldset></article></template>
</main></div></body></html>
