<%@ taglib prefix="seal" uri="https://arte.or.kr/seal/functions" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %><!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>권리요청 상세</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css?v=20260906-3"></head><body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">RIGHTS DETAIL</p><h1><c:out value="${item.record().code()}"/></h1><p><c:out value="${seal:statusLabel('rights-type', item.record().type())}"/> · <c:out value="${seal:statusLabel('rights', item.record().status())}"/></p></div><a class="secondary-button" href="${pageContext.request.contextPath}/admin/rights">목록</a></div><section class="work-panel"><h2>권리요청 업무 정보</h2><dl class="detail-list"><div><dt>대상자</dt><dd><c:out value="${recipient.maskedName()}"/> · <c:out value="${recipient.maskedEmail()}"/></dd></div><div><dt>요청 유형</dt><dd><c:out value="${seal:statusLabel('rights-type', item.record().type())}"/></dd></div><div><dt>접수일 / 처리기한</dt><dd><c:out value="${item.record().receivedDate()}"/> / <c:out value="${item.record().dueDate()}"/></dd></div><div><dt>연결 동의요청</dt><dd><c:choose><c:when test="${not empty consentRequest}"><a href="${pageContext.request.contextPath}/admin/requests/${consentRequest.requestId()}"><c:out value="${consentRequest.requestCode()}"/></a></c:when><c:otherwise>연결 없음</c:otherwise></c:choose></dd></div></dl><h2>요청 내용</h2><p><c:out value="${item.detail()}"/></p><c:if test="${not empty item.verificationNote()}"><h3>본인확인 기록</h3><p><c:out value="${item.verificationNote()}"/></p></c:if><c:if test="${not empty item.resultNote()}"><h3>처리 결과</h3><p><c:out value="${item.resultNote()}"/></p></c:if><sec:authorize access="hasAuthority('RIGHTS_EDIT')"><c:if test="${item.record().status() == 'RECEIVED'}"><form class="stack-form" method="post" action="${pageContext.request.contextPath}/admin/rights/${item.record().id()}/verify"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label>확인 경로<input name="channel" value="OFFLINE_DOCUMENT" required></label><label>확인 기록<textarea name="note" required></textarea></label><div class="form-actions"><button class="primary-button">본인확인 완료</button></div></form></c:if><c:if test="${item.record().status() == 'IDENTITY_VERIFIED'}"><form method="post" action="${pageContext.request.contextPath}/admin/rights/${item.record().id()}/review"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="primary-button">검토 시작</button></form></c:if><c:if test="${item.record().status() == 'APPROVED' || item.record().status() == 'REJECTED'}"><form class="stack-form" method="post" action="${pageContext.request.contextPath}/admin/rights/${item.record().id()}/complete"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label>처리 결과 또는 통지 기록<textarea name="result" required></textarea></label><div class="form-actions"><button class="primary-button"><c:choose><c:when test="${item.record().status() == 'REJECTED'}">반려 통지 완료</c:when><c:otherwise>처리 완료</c:otherwise></c:choose></button></div></form></c:if></sec:authorize><sec:authorize access="hasAuthority('RIGHTS_APPROVE')"><c:if test="${item.record().status() == 'IN_REVIEW'}"><form class="stack-form" method="post" action="${pageContext.request.contextPath}/admin/rights/${item.record().id()}/decision"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label>결정 사유<input name="reason" required></label><div class="form-actions"><button name="approve" value="true" class="primary-button">승인</button><button name="approve" value="false" class="secondary-button">반려</button></div></form></c:if></sec:authorize></section></main></div></body></html>
