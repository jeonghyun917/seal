<%@ taglib prefix="seal" uri="https://arte.or.kr/seal/functions" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>권리요청 접수</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css?v=20260906-3"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/recipient-request.css?v=20260907-2"><script defer src="${pageContext.request.contextPath}/resources/js/recipient-picker.js?v=20260929-1"></script><script defer src="${pageContext.request.contextPath}/resources/js/rights-request-form.js?v=20260907-1"></script></head><body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">NEW RIGHTS REQUEST</p><h1>권리요청 접수</h1><p>본인확인은 접수 후 별도 단계에서 기록합니다.</p></div><a class="secondary-button" href="${pageContext.request.contextPath}/admin/rights">취소</a></div>
<form:form class="work-panel data-form" method="post" action="${pageContext.request.contextPath}/admin/rights" modelAttribute="rightsRequestForm">
<form:errors path="*" cssClass="alert alert-error full-field" element="div"/>
<div class="form-field recipient-picker-field">
<label>대상자</label>
<div class="recipient-selector-summary"><div><strong id="selectedRecipientCount" aria-live="polite">${empty selectedRecipient ? '대상자 미선택' : '대상자 선택됨'}</strong><p id="selectedRecipientPreview"><c:choose><c:when test="${not empty selectedRecipient}"><c:out value="${selectedRecipient.maskedName()}"/> · <c:out value="${selectedRecipient.maskedEmail()}"/></c:when><c:otherwise>선택된 대상자가 없습니다.</c:otherwise></c:choose></p></div><button id="openRecipientPicker" class="secondary-button" type="button">대상자 선택</button></div>
<div id="selectedRecipientInputs"><c:if test="${not empty selectedRecipient}"><input type="hidden" name="recipientId" value="${selectedRecipient.recipientId()}"></c:if></div>
<div id="selectedRecipientSeeds" hidden><c:if test="${not empty selectedRecipient}"><div class="selected-recipient-seed" data-recipient-id="${selectedRecipient.recipientId()}"><span class="seed-name"><c:out value="${selectedRecipient.maskedName()}"/></span><span class="seed-email"><c:out value="${selectedRecipient.maskedEmail()}"/></span><span class="seed-affiliation"><c:out value="${selectedRecipient.affiliationName()}"/></span><span class="seed-job-title"><c:out value="${selectedRecipient.jobTitle()}"/></span><span class="seed-collection-basis"><c:out value="${selectedRecipient.collectionBasis()}"/></span></div></c:if></div>
<form:errors path="recipientId" cssClass="field-error"/>
<dialog id="recipientPickerDialog" class="recipient-picker-dialog" data-selection-mode="single" data-input-name="recipientId" data-options-url="${pageContext.request.contextPath}/admin/rights/recipient-options"><div class="recipient-dialog-shell">
<header><div><span>RECIPIENT SELECTOR</span><h2>대상자 선택</h2><p>활성 수신자를 검색하며 결과는 20명씩 표시됩니다.</p></div><button id="closeRecipientPicker" class="dialog-close" type="button" aria-label="닫기">×</button></header>
<div class="recipient-dialog-search"><input id="recipientSearch" type="search" placeholder="소속기관, 직책, 이름, 이메일 또는 등록 근거 검색" aria-label="대상자 검색"><button id="searchRecipients" class="secondary-button" type="button">검색</button></div>
<div class="recipient-dialog-actions"><span id="recipientResultStatus" aria-live="polite"></span></div>
<div class="recipient-dialog-body"><section class="recipient-results-panel" aria-labelledby="recipientResultsTitle"><h3 id="recipientResultsTitle">검색 결과</h3><div id="recipientResults" class="recipient-results"><p class="recipient-empty">대상자를 불러오는 중입니다.</p></div><nav class="recipient-pagination" aria-label="대상자 검색 결과 페이지"><button id="previousRecipientPage" type="button">이전</button><span id="recipientPageLabel">1페이지</span><button id="nextRecipientPage" type="button">다음</button></nav></section><aside class="recipient-selected-panel"><div><h3>선택한 대상자</h3><strong id="dialogSelectedCount">0명</strong></div><div id="dialogSelectedRecipients" class="dialog-selected-recipients"><p class="recipient-empty">선택된 대상자가 없습니다.</p></div></aside></div>
<footer><button id="cancelRecipientSelection" class="secondary-button" type="button">취소</button><button id="applyRecipientSelection" class="primary-button" type="button">선택 완료</button></footer>
</div></dialog>
</div>
<div class="form-field"><label for="consentRequestId">동의요청</label><form:select path="consentRequestId" id="consentRequestId" data-options-url="${pageContext.request.contextPath}/admin/rights/consent-request-options" data-selected-value="${rightsRequestForm.consentRequestId}"><form:option value="">대상자를 먼저 선택해 주세요</form:option></form:select><span id="consentRequestStatus" class="field-help" aria-live="polite"></span><form:errors path="consentRequestId" cssClass="field-error"/><span class="field-help">삭제·처리제한·동의철회 유형은 필수입니다.</span></div>
<label>유형<form:select path="type" required="required"><form:option value="ACCESS">열람</form:option><form:option value="CORRECTION">정정</form:option><form:option value="ERASURE">삭제</form:option><form:option value="RESTRICTION">처리제한</form:option><form:option value="WITHDRAWAL">동의철회</form:option></form:select></label>
<label>접수일<form:input type="date" path="receivedDate" required="required"/></label>
<label>처리기한<form:input type="date" path="dueDate" required="required"/></label>
<label class="full-field">요청 상세<form:textarea path="detail" required="required" maxlength="2000" rows="8"/></label>
<div class="form-actions"><button class="primary-button" type="submit">접수</button></div>
</form:form></main></div></body></html>
