<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>동의 증적</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"></head><body class="admin-body"><header class="admin-header"><a class="admin-brand" href="${pageContext.request.contextPath}/admin"><span>ARTE</span><strong>개인정보 전자동의·증적 관리시스템</strong></a></header><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">EVIDENCE</p><h1>동의 증적</h1><p>완료 동의의 PDF·JSON·SHA-256·HMAC 무결성 패키지를 관리합니다.</p></div><a class="secondary-button" href="${pageContext.request.contextPath}/admin">대시보드</a></div><section class="work-panel"><form method="get"><label for="status">생성 상태</label><select id="status" name="status"><option value="">전체</option><c:forEach var="s" items="${['QUEUED','PROCESSING','FINALIZED','FAILED','DESTROYED']}"><option value="${s}" ${selectedStatus == s ? 'selected' : ''}>${s}</option></c:forEach></select><button class="secondary-button">조회</button></form><div class="table-scroll"><table class="data-table"><thead><tr><th>요청 ID</th><th>상태</th><th>등록시각</th><th>완료시각</th><th>시도</th></tr></thead><tbody><c:forEach var="item" items="${items}"><tr><td><a href="${pageContext.request.contextPath}/admin/evidence/${item.packageId()}"><c:out value="${item.requestId()}"/></a></td><td><c:out value="${item.status()}"/></td><td><c:out value="${item.queuedAt()}"/></td><td><c:out value="${item.finalizedAt()}"/></td><td><c:out value="${item.attemptCount()}"/></td></tr></c:forEach><c:if test="${empty items}"><tr><td colspan="5">생성된 증적이 없습니다.</td></tr></c:if></tbody></table></div></section></main></body></html>
