<%@ taglib prefix="seal" uri="https://arte.or.kr/seal/functions" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %><!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>정보주체 권리요청</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css?v=20260906-3"></head><body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">DATA SUBJECT RIGHTS</p><h1>정보주체 권리요청</h1><p>관리자가 요청을 접수한 뒤 별도 단계에서 본인확인 결과를 기록합니다.</p></div><sec:authorize access="hasAuthority('RIGHTS_EDIT')"><a class="primary-button" href="${pageContext.request.contextPath}/admin/rights/new">요청 접수</a></sec:authorize></div><section class="work-panel"><form method="get" class="list-filter"><label for="status"><span>상태</span><select id="status" name="status"><option value="">전체</option><c:forEach var="s" items="${['RECEIVED','IDENTITY_VERIFIED','IN_REVIEW','APPROVED','REJECTED','COMPLETED','CANCELLED']}"><option value="${s}" ${selectedStatus == s ? 'selected' : ''}><c:out value="${seal:statusLabel('rights', s)}"/></option></c:forEach></select></label><button class="secondary-button">조회</button></form><div class="table-scroll"><table class="data-table"><thead><tr><th>접수번호</th><th>대상자</th><th>관련 동의서</th><th>유형</th><th>상태</th><th>접수일</th><th>기한</th></tr></thead><tbody><c:forEach var="item" items="${items}"><tr><td><a href="${pageContext.request.contextPath}/admin/rights/${item.id()}"><c:out value="${item.code()}"/></a></td><td><c:set var="recipient" value="${recipientDetails[item.recipientId()]}"/><div class="evidence-recipient-summary"><strong><c:out value="${empty recipient ? '수신자 정보 없음' : recipient.maskedName()}"/></strong><span><c:out value="${empty recipient ? '-' : recipient.maskedEmail()}"/></span></div></td><td><c:out value="${empty item.templateTitle() ? '연결된 동의서 없음 또는 조회 권한 없음' : item.templateTitle()}"/></td><td><c:out value="${seal:statusLabel('rights-type', item.type())}"/></td><td><c:out value="${seal:statusLabel('rights', item.status())}"/></td><td><c:out value="${item.receivedDate()}"/></td><td><c:out value="${item.dueDate()}"/></td></tr></c:forEach><c:if test="${empty items}"><tr><td colspan="7">권리요청이 없습니다.</td></tr></c:if></tbody></table></div><jsp:include page="/WEB-INF/jsp/fragments/admin/pagination.jsp"/></section></main></div></body></html>
