<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %><!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>정보주체 권리요청</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"></head><body class="admin-body"><header class="admin-header"><a class="admin-brand" href="${pageContext.request.contextPath}/admin"><span>ARTE</span><strong>개인정보 전자동의·증적 관리시스템</strong></a></header><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">DATA SUBJECT RIGHTS</p><h1>정보주체 권리요청</h1><p>외부 본인확인 결과를 근거로 관리자만 접수·처리합니다.</p></div><sec:authorize access="hasAuthority('RIGHTS_EDIT')"><a class="primary-button" href="${pageContext.request.contextPath}/admin/rights/new">요청 접수</a></sec:authorize></div><section class="work-panel"><form method="get"><label for="status">상태</label><select id="status" name="status"><option value="">전체</option><c:forEach var="s" items="${['RECEIVED','IDENTITY_VERIFIED','IN_REVIEW','APPROVED','REJECTED','COMPLETED','CANCELLED']}"><option value="${s}" ${selectedStatus == s ? 'selected' : ''}>${s}</option></c:forEach></select><button class="secondary-button">조회</button></form><div class="table-scroll"><table class="data-table"><thead><tr><th>접수번호</th><th>유형</th><th>상태</th><th>접수일</th><th>기한</th></tr></thead><tbody><c:forEach var="item" items="${items}"><tr><td><a href="${pageContext.request.contextPath}/admin/rights/${item.id()}"><c:out value="${item.code()}"/></a></td><td><c:out value="${item.type()}"/></td><td><c:out value="${item.status()}"/></td><td><c:out value="${item.receivedDate()}"/></td><td><c:out value="${item.dueDate()}"/></td></tr></c:forEach><c:if test="${empty items}"><tr><td colspan="5">권리요청이 없습니다.</td></tr></c:if></tbody></table></div></section></main></body></html>
