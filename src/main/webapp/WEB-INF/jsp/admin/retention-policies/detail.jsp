<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>보유정책 상세</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"></head>
<body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">RETENTION POLICY DETAIL</p><h1><c:out value="${policy.policyName()}"/></h1><p><c:out value="${policy.policyCode()}"/> · <c:out value="${policy.organizationName()}"/></p></div><a class="secondary-button" href="${pageContext.request.contextPath}/admin/retention-policies">목록</a></div>
<c:if test="${param.created != null}"><p class="alert alert-success">정책 초안을 생성했습니다.</p></c:if><c:if test="${param.approved != null}"><p class="alert alert-success">정책 버전을 승인했습니다.</p></c:if>
<section class="work-panel"><h2>버전 이력</h2><c:forEach var="version" items="${versions}"><article class="version-card"><div class="version-heading"><div><strong>버전 <c:out value="${version.versionNumber()}"/></strong> <span class="state-text ${version.workflowStatus() == 'APPROVED' ? 'ready' : 'pending'}"><c:out value="${version.workflowStatus()}"/></span></div><span>작성자 <c:out value="${version.createdByName()}"/></span></div><dl class="detail-list"><div><dt>기산 이벤트</dt><dd><c:out value="${version.startEvent()}"/></dd></div><div><dt>보유기간</dt><dd><c:out value="${version.periodValue()}"/> <c:out value="${version.periodUnit()}"/></dd></div><div><dt>파기 유예</dt><dd><c:out value="${version.gracePeriodDays()}"/>일</dd></div><div><dt>파기 방식</dt><dd><c:out value="${version.destructionMethod()}"/></dd></div></dl>
<c:if test="${not empty version.rejectionComment()}"><p class="alert alert-error"><c:out value="${version.rejectionComment()}"/></p></c:if><div class="form-actions">
<c:if test="${version.workflowStatus() == 'DRAFT'}"><form method="post" action="${pageContext.request.contextPath}/admin/retention-policies/${policy.retentionPolicyId()}/versions/${version.retentionPolicyVersionId()}/request-review"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="primary-button" type="submit">검토 요청</button></form></c:if>
<c:if test="${version.workflowStatus() == 'REVIEW_REQUESTED'}"><form method="post" action="${pageContext.request.contextPath}/admin/retention-policies/${policy.retentionPolicyId()}/versions/${version.retentionPolicyVersionId()}/approve"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="primary-button" type="submit">승인</button></form><form class="reject-form" method="post" action="${pageContext.request.contextPath}/admin/retention-policies/${policy.retentionPolicyId()}/versions/${version.retentionPolicyVersionId()}/reject"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label>반려 의견 <input name="comment" required maxlength="1000"></label><button class="secondary-button" type="submit">반려</button></form></c:if>
</div></article></c:forEach></section></main></div></body></html>
