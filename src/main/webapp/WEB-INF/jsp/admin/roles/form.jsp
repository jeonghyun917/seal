<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>${editing ? '역할 수정' : '역할 등록'}</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css?v=20260906-3"></head>
<body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">ROLE</p><h1>${editing ? '역할 수정' : '역할 등록'}</h1><p>업무에 필요한 권한만 선택하고 변경 이력을 보존합니다.</p></div></div>
<c:choose><c:when test="${editing}"><c:set var="formAction" value="${pageContext.request.contextPath}/admin/roles/${role.roleId()}"/></c:when><c:otherwise><c:set var="formAction" value="${pageContext.request.contextPath}/admin/roles"/></c:otherwise></c:choose>
<section class="work-panel"><form:form method="post" action="${formAction}" modelAttribute="roleForm" cssClass="data-form"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><form:hidden path="versionNo"/>
<div class="form-field"><form:label path="roleCode">역할코드</form:label><form:input path="roleCode" maxlength="50" readonly="${editing}"/><form:errors path="roleCode" cssClass="field-error"/></div>
<div class="form-field"><form:label path="roleName">역할명</form:label><form:input path="roleName" maxlength="100"/><form:errors path="roleName" cssClass="field-error"/></div>
<c:if test="${editing}"><div class="form-field"><form:label path="active">활성 상태</form:label><form:select path="active"><form:option value="true" label="활성"/><form:option value="false" label="비활성"/></form:select><c:if test="${role.systemRole()}"><small>시스템 역할도 비활성화할 수 있지만 사용자가 배정된 역할은 먼저 배정을 해제해야 합니다.</small></c:if></div></c:if>
<fieldset class="choice-field permission-grid"><legend>권한</legend><c:forEach var="permission" items="${permissions}"><label><form:checkbox path="permissionIds" value="${permission.permissionId()}"/> <strong><c:out value="${permission.permissionName()}"/></strong> <small><c:out value="${permission.permissionCode()}"/></small><c:if test="${not empty permission.description()}"><span><c:out value="${permission.description()}"/></span></c:if></label></c:forEach><form:errors path="permissionIds" cssClass="field-error"/></fieldset>
<div class="form-actions"><a class="secondary-button" href="${pageContext.request.contextPath}/admin/roles">취소</a><button class="primary-button" type="submit">${editing ? '변경 저장' : '역할 생성'}</button></div></form:form></section></main></div></body></html>
