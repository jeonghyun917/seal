<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>보유정책 | 개인정보 전자동의·증적 관리시스템</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"></head>
<body class="admin-body"><header class="admin-header"><a class="admin-brand" href="${pageContext.request.contextPath}/admin"><span>ARTE</span><strong>개인정보 전자동의·증적 관리시스템</strong></a><div class="user-actions"><span><strong><c:out value="${administrator.displayName()}"/></strong> 님</span></div></header>
<div class="admin-layout"><nav class="admin-nav"><a href="${pageContext.request.contextPath}/admin">대시보드</a><span class="nav-group">기준정보</span><a href="${pageContext.request.contextPath}/admin/organizations">조직 관리</a><a class="active" href="${pageContext.request.contextPath}/admin/retention-policies">보유정책</a><a href="${pageContext.request.contextPath}/admin/processing-activities">처리업무</a><span class="nav-group">시스템 관리</span><a href="${pageContext.request.contextPath}/admin/users">관리자 계정</a><a href="${pageContext.request.contextPath}/admin/roles">역할·권한</a><a href="${pageContext.request.contextPath}/admin/audit-events">감사 이력</a></nav>
<main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">RETENTION POLICY</p><h1>보유정책</h1><p>조직별 보유기간, 기산시점과 파기 기준의 승인 현황을 조회합니다.</p></div><a class="primary-button" href="${pageContext.request.contextPath}/admin/retention-policies/new">새 정책 등록</a></div><section class="work-panel"><h2>정책 목록</h2><div class="table-scroll"><table class="data-table"><thead><tr><th>정책코드</th><th>정책명</th><th>소유 조직</th><th>승인 버전</th><th>보유기간</th><th>상태</th></tr></thead><tbody>
<c:forEach var="policy" items="${policies}"><tr><td><c:out value="${policy.policyCode()}"/></td><td><a href="${pageContext.request.contextPath}/admin/retention-policies/${policy.retentionPolicyId()}"><c:out value="${policy.policyName()}"/></a></td><td><c:out value="${policy.organizationName()}"/></td><td><c:out value="${policy.approvedVersionNumber()}" default="미승인"/></td><td><c:choose><c:when test="${not empty policy.periodValue()}"><c:out value="${policy.periodValue()}"/> <c:out value="${policy.periodUnit()}"/></c:when><c:otherwise>-</c:otherwise></c:choose></td><td><span class="state-text ${policy.policyStatus() == 'ACTIVE' ? 'ready' : 'pending'}"><c:out value="${policy.policyStatus()}"/></span></td></tr></c:forEach>
<c:if test="${empty policies}"><tr><td colspan="6">등록된 보유정책이 없습니다. 작성 권한이 있는 관리자는 다음 개발 단위에서 정책을 등록할 수 있습니다.</td></tr></c:if></tbody></table></div></section></main></div></body></html>
