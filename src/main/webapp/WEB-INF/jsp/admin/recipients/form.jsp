<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>${editing ? '동의 수신자 수정' : '동의 수신자 등록'}</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css?v=20260906-3"></head>
<body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">RECIPIENT</p><h1>${editing ? '동의 수신자 수정' : '동의 수신자 등록'}</h1><p>${editing ? '이름·이메일은 변경할 때만 입력하세요. 수신자 소속기관은 화면의 입력값대로 저장됩니다.' : '개인정보 동의 요청 이메일을 받을 내부·외부 수신자를 등록합니다.'}</p></div></div>
<c:set var="formAction" value="${editing ? pageContext.request.contextPath.concat('/admin/recipients/').concat(recipient.recipientId()) : pageContext.request.contextPath.concat('/admin/recipients')}"/>
<section class="work-panel"><form:form method="post" action="${formAction}" modelAttribute="recipientForm" cssClass="data-form"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><form:hidden path="versionNo"/>
<div class="form-field"><label for="organizationUnitDisplay">관리 기관</label><input id="organizationUnitDisplay" type="text" value="${institutionName}" readonly aria-readonly="true"/><form:hidden path="organizationUnitId"/><form:errors path="organizationUnitId" cssClass="field-error"/></div>
<div class="form-field"><form:label path="affiliationName">수신자 소속기관(선택)</form:label><form:input path="affiliationName" maxlength="200" placeholder="예: 주식회사 예술교육"/><form:errors path="affiliationName" cssClass="field-error"/></div>
<div class="form-field"><form:label path="jobTitle">수신자 직책(선택)</form:label><form:input path="jobTitle" maxlength="100" placeholder="예: 교육팀장"/><form:errors path="jobTitle" cssClass="field-error"/></div>
<div class="form-field"><form:label path="name">이름</form:label><form:input path="name" maxlength="100" placeholder="${editing ? recipient.maskedName().concat(' (변경 시 입력)') : '이름'}"/><form:errors path="name" cssClass="field-error"/></div>
<div class="form-field"><form:label path="email">이메일</form:label><form:input path="email" type="email" maxlength="254" autocomplete="off" placeholder="${editing ? recipient.maskedEmail().concat(' (변경 시 입력)') : 'name@example.com'}"/><form:errors path="email" cssClass="field-error"/></div>
<div class="form-field full-field"><form:label path="collectionBasis">수신자 정보 등록 근거</form:label><form:textarea path="collectionBasis" rows="4" maxlength="500"/><form:errors path="collectionBasis" cssClass="field-error"/></div>
<div class="form-actions"><a class="secondary-button" href="${pageContext.request.contextPath}/admin/recipients">취소</a><button class="primary-button" type="submit">${editing ? '변경 저장' : '수신자 등록'}</button></div></form:form></section></main></div></body></html>
