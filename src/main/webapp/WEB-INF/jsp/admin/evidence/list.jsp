<%@ taglib prefix="seal" uri="https://arte.or.kr/seal/functions" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>동의 증적</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css?v=20260907-1"></head><body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">EVIDENCE</p><h1>동의 증적</h1><p>완료 동의의 PDF·JSON·SHA-256·HMAC 무결성 패키지를 관리합니다.</p></div><a class="secondary-button" href="${pageContext.request.contextPath}/admin">대시보드</a></div><section class="work-panel"><form method="get" class="list-filter"><label for="status"><span>생성 상태</span><select id="status" name="status"><option value="">전체</option><c:forEach var="s" items="${['QUEUED','PROCESSING','FINALIZED','FAILED','DESTROYED']}"><option value="${s}" ${selectedStatus == s ? 'selected' : ''}><c:out value="${seal:statusLabel('evidence', s)}"/></option></c:forEach></select></label><button class="secondary-button">조회</button></form><div class="table-scroll"><table class="data-table evidence-list-table"><thead><tr><th>동의서</th><th>수신자</th><th>응답 결과</th><th>증적 상태</th><th>완료시각</th></tr></thead><tbody><c:forEach var="item" items="${items}"><tr><td><div class="evidence-request-summary"><a href="${pageContext.request.contextPath}/admin/evidence/${item.packageId()}"><c:out value="${item.templateTitle()}"/></a><span>요청번호 <c:out value="${item.requestCode()}"/></span></div></td><td><div class="evidence-recipient-summary"><strong><c:out value="${item.maskedName()}"/></strong><span><c:out value="${item.maskedEmail()}"/></span></div></td><td><c:out value="${item.responseSummary()}"/></td><td><span class="state-text ${item.status() == 'FINALIZED' ? 'ready' : 'pending'}"><c:out value="${seal:statusLabel('evidence', item.status())}"/></span><c:if test="${item.status() == 'FAILED'}"><span class="evidence-attempt-detail"><c:out value="${item.attemptCount()}"/>회 시도</span></c:if></td><td><c:out value="${empty item.finalizedAt() ? '-' : seal:dateTime(item.finalizedAt())}"/></td></tr></c:forEach><c:if test="${empty items}"><tr><td colspan="5">생성된 증적이 없습니다.</td></tr></c:if></tbody></table></div><jsp:include page="/WEB-INF/jsp/fragments/admin/pagination.jsp"/></section></main></div></body></html>
