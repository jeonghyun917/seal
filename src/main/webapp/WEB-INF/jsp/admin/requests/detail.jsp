<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>동의 요청 상세</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/recipient-request.css"></head><body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main">
<div class="page-heading-row"><div><p class="section-kicker">REQUEST DETAIL</p><h1><c:out value="${request.requestCode()}"/></h1><p><span class="request-state state-${request.status()}"><c:out value="${request.status()}"/></span></p></div><div class="request-actions"><c:if test="${request.status() == 'DRAFT'}"><a class="primary-button" href="${pageContext.request.contextPath}/admin/requests/${request.requestId()}/edit">초안 수정</a></c:if><a class="secondary-button" href="${pageContext.request.contextPath}/admin/requests">목록</a></div></div>
<section class="work-panel"><dl class="detail-list"><div><dt>대상자</dt><dd><c:out value="${recipient.maskedName()}"/> · <c:out value="${recipient.maskedEmail()}"/></dd></div><div><dt>만료일시</dt><dd><c:out value="${request.expiresAt()}"/></dd></div><div><dt>템플릿 버전 ID</dt><dd><c:out value="${request.templateVersionId()}"/></dd></div><div><dt>스냅샷</dt><dd><c:out value="${empty request.snapshotId() ? '미확정' : request.snapshotId()}"/></dd></div></dl><c:if test="${not empty request.snapshotId()}"><p><a class="secondary-button" href="${pageContext.request.contextPath}/admin/requests/${request.requestId()}/preview">확정 내용 보기</a></p></c:if></section>
<section class="request-actions">
<c:if test="${request.status() == 'DRAFT'}"><form method="post" action="${pageContext.request.contextPath}/admin/requests/${request.requestId()}/finalize"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="versionNo" value="${request.versionNo()}"><button class="primary-button">내용 확정</button></form></c:if>
<c:if test="${request.status() == 'READY'}"><form method="post" action="${pageContext.request.contextPath}/admin/requests/${request.requestId()}/deliver"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="versionNo" value="${request.versionNo()}"><label>발송 예약(선택)<input type="datetime-local" name="scheduledAt"></label><button class="primary-button">HTML 이메일 발송 등록</button></form></c:if>
<c:if test="${request.status() == 'ACTIVE'}"><form method="post" action="${pageContext.request.contextPath}/admin/requests/${request.requestId()}/redeliver"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="versionNo" value="${request.versionNo()}"><label>재발송 예약(선택)<input type="datetime-local" name="scheduledAt"></label><button class="secondary-button">링크 재발급·메일 등록</button></form></c:if>
<c:if test="${request.status() == 'DRAFT' or request.status() == 'READY' or request.status() == 'ACTIVE'}"><form class="cancel-request" method="post" action="${pageContext.request.contextPath}/admin/requests/${request.requestId()}/cancel"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="versionNo" value="${request.versionNo()}"><label>취소 사유<input name="reason" minlength="5" maxlength="500" required></label><button class="secondary-button">요청 취소</button></form></c:if>
<c:if test="${request.status() == 'COMPLETED'}"><a class="secondary-button" href="${pageContext.request.contextPath}/admin/evidence">완료 동의 증적 보기</a></c:if></section></main></div></body></html>
