<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>처리업무 등록</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"></head><body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">NEW PROCESSING ACTIVITY</p><h1>처리업무 등록</h1><p>처리 목적·근거, 승인 보유정책과 일반 개인정보 항목을 함께 등록합니다.</p></div></div>
<section class="work-panel"><form:form method="post" action="${pageContext.request.contextPath}/admin/processing-activities" modelAttribute="activityForm" cssClass="data-form"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><div class="form-field"><form:label path="activityCode">업무코드</form:label><form:input path="activityCode" maxlength="30"/><form:errors path="activityCode" cssClass="field-error"/></div><div class="form-field"><form:label path="activityName">업무명</form:label><form:input path="activityName" maxlength="100"/><form:errors path="activityName" cssClass="field-error"/></div><div class="form-field"><form:label path="ownerOrganizationUnitId">소유 조직</form:label><form:select path="ownerOrganizationUnitId"><form:option value="" label="선택"/><c:forEach var="o" items="${organizations}"><form:option value="${o.organizationUnitId()}" label="${o.organizationName()}"/></c:forEach></form:select><form:errors path="ownerOrganizationUnitId" cssClass="field-error"/></div><div class="form-field"><form:label path="retentionPolicyVersionId">승인 보유정책</form:label><form:select path="retentionPolicyVersionId"><form:option value="" label="선택"/><c:forEach var="p" items="${retentionPolicies}"><form:option value="${p.retentionPolicyVersionId()}" label="${p.policyName()} v${p.versionNumber()}"/></c:forEach></form:select><form:errors path="retentionPolicyVersionId" cssClass="field-error"/></div><div class="form-field"><form:label path="legalBasisType">처리 근거 유형</form:label><form:select path="legalBasisType"><form:options items="${legalBasisTypes}"/></form:select></div><div class="form-field"><form:label path="legalBasisDetail">처리 근거 상세</form:label><form:textarea path="legalBasisDetail" maxlength="1000"/><form:errors path="legalBasisDetail" cssClass="field-error"/></div><div class="form-field full-field"><form:label path="processingPurpose">처리 목적</form:label><form:textarea path="processingPurpose" maxlength="1000"/><form:errors path="processingPurpose" cssClass="field-error"/></div>
<fieldset class="choice-field permission-grid"><legend>일반 개인정보 항목</legend><c:forEach var="i" begin="1" end="3"><div class="data-item-row"><form:input path="itemName${i}" placeholder="항목명"/><form:input path="necessityReason${i}" placeholder="필요성 설명"/><label><form:checkbox path="required${i}"/> 필수</label><form:errors path="itemName${i}" cssClass="field-error"/><form:errors path="necessityReason${i}" cssClass="field-error"/></div></c:forEach></fieldset><div class="form-actions"><a class="secondary-button" href="${pageContext.request.contextPath}/admin/processing-activities">취소</a><button class="primary-button" type="submit">초안 생성</button></div></form:form></section></main></div></body></html>
