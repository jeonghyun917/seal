<%@ taglib prefix="seal" uri="https://arte.or.kr/seal/functions" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>메일 발송함</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css?v=20260906-3"></head><body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">MAIL OUTBOX</p><h1>메일 발송함</h1><p>SMTP 수락 상태는 최종 수신·열람을 의미하지 않습니다.</p></div><a class="secondary-button" href="${pageContext.request.contextPath}/admin/requests">동의 요청</a></div><c:if test="${not mailEnabled}"><p class="alert">발송 비활성화(로컬) · 대기열과 HTML 미리보기만 검증하며 외부 SMTP로 전송하지 않습니다.</p></c:if><section class="work-panel"><form method="get" class="list-filter"><label for="q"><span>제목·요청번호</span><input id="q" name="q" value="<c:out value='${q}'/>" placeholder="검색어"></label><label for="status"><span>상태</span><select id="status" name="status"><option value="">전체</option><c:forEach var="state" items="${['QUEUED','PROCESSING','SMTP_ACCEPTED','RETRY_SCHEDULED','SEND_FAILED','CANCELLED','DESTROYED']}"><option value="${state}" ${selectedStatus == state ? 'selected' : ''}><c:out value="${seal:statusLabel('mail', state)}"/></option></c:forEach></select></label><button class="secondary-button">조회</button></form><div class="table-scroll"><table class="data-table"><thead><tr><th>대상자</th><th>요청·제목</th><th>상태</th><th>예약일시</th><th>시도</th></tr></thead><tbody><c:forEach var="mail" items="${mailItems}"><tr><td><c:out value="${mail.recipient().maskedName()}"/> · <c:out value="${mail.recipient().maskedEmail()}"/></td><td><a href="${pageContext.request.contextPath}/admin/mail-outbox/${mail.summary().outboxId()}"><c:out value="${mail.request().requestCode()}"/> · <c:out value="${mail.summary().subject()}"/></a></td><td><c:out value="${seal:statusLabel('mail', mail.summary().status())}"/></td><td><c:out value="${seal:dateTime(mail.summary().scheduledAt())}"/></td><td><c:out value="${mail.summary().attemptCount()}"/></td></tr></c:forEach><c:if test="${empty mailItems}"><tr><td colspan="5">발송 내역이 없습니다.</td></tr></c:if></tbody></table></div><jsp:include page="/WEB-INF/jsp/fragments/admin/pagination.jsp"/></section></main></div></body></html>
