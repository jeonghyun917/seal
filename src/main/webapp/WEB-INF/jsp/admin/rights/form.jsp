<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>권리요청 접수</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"></head><body class="admin-body"><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">NEW RIGHTS REQUEST</p><h1>권리요청 접수</h1><p>본인확인은 접수 후 별도 단계에서 기록합니다.</p></div><a class="secondary-button" href="${pageContext.request.contextPath}/admin/rights">취소</a></div><form class="work-panel" method="post" action="${pageContext.request.contextPath}/admin/rights"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label>조직 ID<input name="organizationId" required></label><label>대상자 ID<input name="recipientId" required></label><label>동의요청 ID<input name="consentRequestId"></label><label>유형<select name="type"><option>ACCESS</option><option>CORRECTION</option><option>ERASURE</option><option>RESTRICTION</option><option>WITHDRAWAL</option></select></label><label>접수일<input type="date" name="receivedDate" required></label><label>처리기한<input type="date" name="dueDate" required></label><label>요청 상세<textarea name="detail" required maxlength="2000"></textarea></label><button class="primary-button">접수</button></form></main></body></html>
