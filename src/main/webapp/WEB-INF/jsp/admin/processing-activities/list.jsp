<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>처리업무 | 개인정보 전자동의·증적 관리시스템</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"></head>
<body class="admin-body"><header class="admin-header"><a class="admin-brand" href="${pageContext.request.contextPath}/admin"><span>ARTE</span><strong>개인정보 전자동의·증적 관리시스템</strong></a><div class="user-actions"><span><strong><c:out value="${administrator.displayName()}"/></strong> 님</span></div></header>
<div class="admin-layout"><nav class="admin-nav"><a href="${pageContext.request.contextPath}/admin">대시보드</a><span class="nav-group">기준정보</span><a href="${pageContext.request.contextPath}/admin/organizations">조직 관리</a><a href="${pageContext.request.contextPath}/admin/retention-policies">보유정책</a><a class="active" href="${pageContext.request.contextPath}/admin/processing-activities">처리업무</a><span class="nav-group">시스템 관리</span><a href="${pageContext.request.contextPath}/admin/users">관리자 계정</a><a href="${pageContext.request.contextPath}/admin/roles">역할·권한</a><a href="${pageContext.request.contextPath}/admin/audit-events">감사 이력</a></nav>
<main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">PROCESSING ACTIVITY</p><h1>처리업무</h1><p>개인정보 처리 목적·근거와 승인 정책 연결 현황을 조회합니다.</p></div><a class="primary-button" href="${pageContext.request.contextPath}/admin/processing-activities/new">처리업무 등록</a></div><section class="work-panel"><h2>처리업무 목록</h2><div class="table-scroll"><table class="data-table"><thead><tr><th>업무코드</th><th>업무명</th><th>소유 조직</th><th>승인 버전</th><th>처리 근거</th><th>상태</th></tr></thead><tbody>
<c:forEach var="activity" items="${activities}"><tr><td><a href="${pageContext.request.contextPath}/admin/processing-activities/${activity.processingActivityId()}"><c:out value="${activity.activityCode()}"/></a></td><td><c:out value="${activity.activityName()}"/></td><td><c:out value="${activity.organizationName()}"/></td><td><c:out value="${activity.approvedVersionNumber()}" default="미승인"/></td><td><c:out value="${activity.legalBasisType()}" default="-"/></td><td><span class="state-text ${activity.activityStatus() == 'ACTIVE' ? 'ready' : 'pending'}"><c:out value="${activity.activityStatus()}"/></span></td></tr></c:forEach>
<c:if test="${empty activities}"><tr><td colspan="6">등록된 처리업무가 없습니다. 보유정책 승인 후 처리업무를 등록합니다.</td></tr></c:if></tbody></table></div></section></main></div></body></html>
