<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="referrer" content="no-referrer"><title>일회용 링크 발급</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/recipient-request.css"></head><body class="admin-body"><main class="admin-main issued-page"><div class="page-heading-row"><div><p class="section-kicker">ONE-TIME DISPLAY</p><h1>일회용 보안 링크가 발급되었습니다</h1><p>이 화면을 벗어나면 원문 토큰을 다시 확인할 수 없습니다.</p></div></div><section class="work-panel issued-card"><label for="issued-url">정보주체용 링크</label><input id="issued-url" readonly value="${pageContext.request.contextPath}/consent/<c:out value='${issuedLink.token()}'/>"><p>만료일시: <c:out value="${issuedLink.expiresAt()}"/></p><a class="primary-button" href="${pageContext.request.contextPath}/admin/requests/${requestId}">요청 상세로 이동</a></section></main></body></html>
