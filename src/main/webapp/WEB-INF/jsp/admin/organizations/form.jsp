<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>${editing ? '조직 수정' : '조직 등록'}</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css?v=20260906-3"></head>
<body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">ORGANIZATION</p><h1>${editing ? '조직 수정' : '조직 등록'}</h1><p>조직 구조와 활성 상태는 관리자 접근 범위의 기준이 됩니다.</p></div></div>
<c:set var="formAction" value="${editing ? pageContext.request.contextPath.concat('/admin/organizations/').concat(organization.organizationUnitId()) : pageContext.request.contextPath.concat('/admin/organizations')}"/>
<section class="work-panel"><form:form method="post" action="${formAction}" modelAttribute="organizationForm" cssClass="data-form"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><form:hidden path="versionNo"/>
<div class="form-field"><form:label path="organizationCode">조직코드</form:label><form:input path="organizationCode" maxlength="30" readonly="${editing}"/><form:errors path="organizationCode" cssClass="field-error"/></div>
<div class="form-field"><form:label path="organizationName">조직명</form:label><form:input path="organizationName" maxlength="100"/><form:errors path="organizationName" cssClass="field-error"/></div>
<div class="form-field"><form:label path="parentId">상위 조직</form:label><form:select path="parentId" disabled="${editing and organization.rootUnit()}"><form:option value="" label="선택"/><c:forEach var="parent" items="${parentOrganizations}"><c:if test="${not editing or parent.organizationUnitId() != organization.organizationUnitId()}"><form:option value="${parent.organizationUnitId()}" label="${parent.organizationName()}"/></c:if></c:forEach></form:select><form:errors path="parentId" cssClass="field-error"/></div>
<c:if test="${editing}"><div class="form-field"><form:label path="active">활성 상태</form:label><form:select path="active" disabled="${organization.rootUnit()}"><form:option value="true" label="활성"/><form:option value="false" label="비활성"/></form:select></div></c:if>
<div class="form-actions"><a class="secondary-button" href="${pageContext.request.contextPath}/admin/organizations">취소</a><button class="primary-button" type="submit">${editing ? '변경 저장' : '조직 생성'}</button></div></form:form></section></main></div></body></html>
