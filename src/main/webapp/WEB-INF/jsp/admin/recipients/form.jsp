<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>${editing ? '대상자 수정' : '대상자 등록'}</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"></head>
<body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">RECIPIENT</p><h1>${editing ? '대상자 수정' : '대상자 등록'}</h1><p>${editing ? '변경할 개인정보만 입력하세요. 비워 두면 기존 암호화 값을 유지합니다.' : '동의 요청에 사용할 최소 개인정보를 등록합니다.'}</p></div></div>
<c:set var="formAction" value="${editing ? pageContext.request.contextPath.concat('/admin/recipients/').concat(recipient.recipientId()) : pageContext.request.contextPath.concat('/admin/recipients')}"/>
<section class="work-panel"><form:form method="post" action="${formAction}" modelAttribute="recipientForm" cssClass="data-form"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><form:hidden path="versionNo"/>
<div class="form-field"><form:label path="organizationUnitId">소속 조직</form:label><form:select path="organizationUnitId" disabled="${editing}"><form:option value="" label="선택"/><c:forEach var="organization" items="${organizations}"><form:option value="${organization.organizationUnitId()}" label="${organization.organizationName()}"/></c:forEach></form:select><c:if test="${editing}"><form:hidden path="organizationUnitId"/></c:if><form:errors path="organizationUnitId" cssClass="field-error"/></div>
<div class="form-field"><form:label path="name">이름</form:label><form:input path="name" maxlength="100" placeholder="${editing ? recipient.maskedName().concat(' (변경 시 입력)') : '이름'}"/><form:errors path="name" cssClass="field-error"/></div>
<div class="form-field"><form:label path="email">이메일</form:label><form:input path="email" type="email" maxlength="254" autocomplete="off" placeholder="${editing ? recipient.maskedEmail().concat(' (변경 시 입력)') : 'name@example.com'}"/><form:errors path="email" cssClass="field-error"/></div>
<div class="form-field full-field"><form:label path="collectionBasis">수집 근거</form:label><form:textarea path="collectionBasis" rows="4" maxlength="500"/><form:errors path="collectionBasis" cssClass="field-error"/></div>
<div class="form-actions"><a class="secondary-button" href="${pageContext.request.contextPath}/admin/recipients">취소</a><button class="primary-button" type="submit">${editing ? '변경 저장' : '대상자 등록'}</button></div></form:form></section></main></div></body></html>
