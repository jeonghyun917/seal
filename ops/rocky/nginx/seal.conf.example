upstream seal_tomcat {
    server 127.0.0.1:9090;
    keepalive 32;
}

server {
    listen 80;
    server_name consent.arte.or.kr;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name consent.arte.or.kr;
    server_tokens off;

    ssl_certificate     /etc/pki/tls/certs/consent.arte.or.kr.fullchain.pem;
    ssl_certificate_key /etc/pki/tls/private/consent.arte.or.kr.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    client_max_body_size 10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location / {
        proxy_pass http://seal_tomcat;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location = /actuator/health {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://seal_tomcat/actuator/health;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}
