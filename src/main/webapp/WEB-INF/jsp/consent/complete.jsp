<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="referrer" content="no-referrer"><title>동의 제출 완료</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/public-consent.css"></head><body><main class="consent-shell"><section class="consent-card complete"><div class="complete-icon" aria-hidden="true">✓</div><p class="kicker">SUBMITTED</p><h1>응답이 안전하게 제출되었습니다</h1><dl class="summary receipt-summary"><dt>동의서</dt><dd><c:out value="${receipt.title()}"/></dd><dt>제출일시</dt><dd><c:out value="${receipt.submittedAtLabel()}"/></dd></dl><ul class="review-list receipt-list"><c:forEach var="item" items="${receipt.items()}"><li><strong><c:out value="${item.title()}"/></strong><span class="decision ${item.decisionLabel() == '동의' ? 'agree' : 'disagree'}"><c:out value="${item.decisionLabel()}"/></span></li></c:forEach></ul><div class="withdrawal receipt-guidance"><strong>변경·철회 안내</strong><p><c:out value="${receipt.withdrawalNotice()}"/></p></div></section></main></body></html>
