<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>운영 통계</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"></head><body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">OPERATION STATISTICS</p><h1>운영 통계</h1><p>조직 범위 내 상태별 건수만 제공하며 이름·이메일·대상자 식별자는 포함하지 않습니다.</p></div><a class="secondary-button" href="${pageContext.request.contextPath}/admin">대시보드</a></div><section class="work-panel"><form method="get"><label>시작일<input type="date" name="from" value="${from}"></label><label>종료일<input type="date" name="to" value="${to}"></label><button class="secondary-button">조회</button></form><div class="admin-grid"><c:set var="groups" value="${[statistics.requests(),statistics.responses(),statistics.mail(),statistics.evidence(),statistics.rights(),statistics.retention()]}"/><c:set var="titles" value="${['동의 요청','동의 응답·철회','메일','증적','권리요청','파기·보존 보류']}"/><c:forEach var="group" items="${groups}" varStatus="loop"><article class="work-panel"><h2><c:out value="${titles[loop.index]}"/></h2><table class="data-table"><thead><tr><th>상태</th><th>건수</th></tr></thead><tbody><c:forEach var="row" items="${group}"><tr><td><c:out value="${row.status()}"/></td><td><c:out value="${row.count()}"/></td></tr></c:forEach><c:if test="${empty group}"><tr><td colspan="2">내역 없음</td></tr></c:if></tbody></table></article></c:forEach></div></section></main></div></body></html>
