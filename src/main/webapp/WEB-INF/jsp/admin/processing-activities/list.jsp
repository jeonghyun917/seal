<%@ taglib prefix="seal" uri="https://arte.or.kr/seal/functions" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>개인정보 이용 업무 | 개인정보 전자동의·증적 관리시스템</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css?v=20260906-3"></head>
<body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/>

<div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">PROCESSING ACTIVITY</p><h1>개인정보 이용 업무</h1><p>개인정보를 사용하는 업무와 이용 근거, 승인된 보유정책 연결 현황을 확인합니다.</p></div><a class="primary-button" href="${pageContext.request.contextPath}/admin/processing-activities/new">개인정보 이용 업무 등록</a></div><section class="work-panel"><h2>개인정보 이용 업무 목록</h2><div class="table-scroll"><table class="data-table"><thead><tr><th>업무코드</th><th>업무 이름</th><th>소유 조직</th><th>승인 버전</th><th>개인정보 이용 근거</th><th>상태</th></tr></thead><tbody>
<c:forEach var="activity" items="${activities}"><tr><td><a href="${pageContext.request.contextPath}/admin/processing-activities/${activity.processingActivityId()}"><c:out value="${activity.activityCode()}"/></a></td><td><c:out value="${activity.activityName()}"/></td><td><c:out value="${activity.organizationName()}"/></td><td><c:out value="${activity.approvedVersionNumber()}" default="미승인"/></td><td><c:out value="${activity.legalBasisType()}" default="-"/></td><td><span class="state-text ${activity.activityStatus() == 'ACTIVE' ? 'ready' : 'pending'}"><c:out value="${seal:statusLabel('active', activity.activityStatus())}"/></span></td></tr></c:forEach>
<c:if test="${empty activities}"><tr><td colspan="6">등록된 개인정보 이용 업무가 없습니다. 보유정책 승인 후 개인정보 이용 업무를 등록합니다.</td></tr></c:if></tbody></table></div></section></main></div></body></html>
