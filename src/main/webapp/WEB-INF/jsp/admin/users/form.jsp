<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>${editing ? '관리자 수정' : '관리자 등록'}</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css?v=20260906-3"></head><body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">ADMINISTRATOR</p><h1>${editing ? '관리자 수정' : '관리자 등록'}</h1><p>역할과 조직 범위는 최소 권한 원칙에 따라 지정합니다.</p></div></div>
<c:choose><c:when test="${editing}"><c:set var="formAction" value="${pageContext.request.contextPath}/admin/users/${user.adminUserId()}"/></c:when><c:otherwise><c:set var="formAction" value="${pageContext.request.contextPath}/admin/users"/></c:otherwise></c:choose>
<section class="work-panel"><form:form method="post" action="${formAction}" modelAttribute="adminUserForm" cssClass="data-form"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><form:hidden path="versionNo"/>
<div class="form-field"><form:label path="loginId">로그인 ID</form:label><form:input path="loginId" maxlength="50" readonly="${editing}"/><form:errors path="loginId" cssClass="field-error"/></div><div class="form-field"><form:label path="displayName">이름</form:label><form:input path="displayName" maxlength="100"/><form:errors path="displayName" cssClass="field-error"/></div>
<div class="form-field"><form:label path="organizationUnitId">소속 조직</form:label><form:select path="organizationUnitId"><form:option value="" label="선택"/><c:forEach var="organization" items="${organizations}"><form:option value="${organization.organizationUnitId()}" label="${organization.organizationName()}"/></c:forEach></form:select><form:errors path="organizationUnitId" cssClass="field-error"/></div>
<c:if test="${not editing}"><div class="form-field"><form:label path="temporaryPassword">임시 비밀번호</form:label><form:password path="temporaryPassword" maxlength="128" autocomplete="new-password"/><form:errors path="temporaryPassword" cssClass="field-error"/></div></c:if><c:if test="${editing}"><div class="form-field"><form:label path="accountStatus">계정 상태</form:label><form:select path="accountStatus"><form:option value="ACTIVE" label="활성"/><form:option value="LOCKED" label="잠금"/><form:option value="INACTIVE" label="비활성"/></form:select></div></c:if>
<fieldset class="choice-field"><legend>역할</legend><c:forEach var="role" items="${roles}"><label><form:checkbox path="roleIds" value="${role.roleId()}"/> <c:out value="${role.roleName()}"/></label></c:forEach><form:errors path="roleIds" cssClass="field-error"/></fieldset>
<fieldset class="choice-field"><legend>조직 범위</legend><c:forEach var="scope" items="${organizations}"><label><form:checkbox path="organizationScopeIds" value="${scope.organizationUnitId()}"/> <c:out value="${scope.organizationName()}"/></label></c:forEach><form:errors path="organizationScopeIds" cssClass="field-error"/></fieldset>
<div class="form-actions"><a class="secondary-button" href="${pageContext.request.contextPath}/admin/users">취소</a><button class="primary-button" type="submit">${editing ? '변경 저장' : '관리자 생성'}</button></div></form:form></section></main></div></body></html>
