<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>동의 대상자 | 개인정보 전자동의 관리시스템</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"></head>
<body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/>

<div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">RECIPIENT</p><h1>동의 대상자</h1><p>이름과 이메일은 암호화해 저장하고 화면에는 마스킹하여 표시합니다.</p></div><div class="form-actions"><a class="secondary-button" href="${pageContext.request.contextPath}/admin/recipients/import">Excel 반입</a><a class="primary-button" href="${pageContext.request.contextPath}/admin/recipients/new">대상자 등록</a></div></div>
<section class="work-panel"><form class="data-form" method="get"><div class="form-field"><label for="email">이메일 정확 검색</label><input id="email" type="email" name="email" value="<c:out value='${email}'/>" placeholder="전체 이메일 입력"></div><div class="form-field"><label for="status">상태</label><select id="status" name="status"><option value="">전체</option><option value="ACTIVE" ${selectedStatus == 'ACTIVE' ? 'selected' : ''}>활성</option><option value="INACTIVE" ${selectedStatus == 'INACTIVE' ? 'selected' : ''}>비활성</option><option value="DESTROYED" ${selectedStatus == 'DESTROYED' ? 'selected' : ''}>파기 완료</option></select></div><div class="form-actions"><button class="secondary-button" type="submit">조회</button></div></form>
<div class="table-scroll"><table class="data-table"><thead><tr><th>이름</th><th>이메일</th><th>수집 근거</th><th>상태</th></tr></thead><tbody><c:forEach var="recipient" items="${recipients}"><tr><td><a href="${pageContext.request.contextPath}/admin/recipients/${recipient.recipientId()}"><c:out value="${recipient.maskedName()}"/></a></td><td><c:out value="${recipient.maskedEmail()}"/></td><td><c:out value="${recipient.collectionBasis()}"/></td><td><c:out value="${recipient.status()}"/></td></tr></c:forEach><c:if test="${empty recipients}"><tr><td colspan="4">조건에 맞는 대상자가 없습니다.</td></tr></c:if></tbody></table></div><jsp:include page="/WEB-INF/jsp/fragments/admin/pagination.jsp"/></section></main></div></body></html>
