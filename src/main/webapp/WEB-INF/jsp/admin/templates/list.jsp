<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>동의서 템플릿 | 개인정보 전자동의 관리시스템</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/template.css"></head>
<body class="admin-body"><header class="admin-header"><a class="admin-brand" href="${pageContext.request.contextPath}/admin"><span>ARTE</span><strong>개인정보 전자동의 관리시스템</strong></a><div class="user-actions"><span><strong><c:out value="${administrator.displayName()}"/></strong> 님</span></div></header>
<div class="admin-layout"><nav class="admin-nav" aria-label="관리자 주 메뉴"><a href="${pageContext.request.contextPath}/admin">대시보드</a><span class="nav-group">기준정보</span><a href="${pageContext.request.contextPath}/admin/retention-policies">보유정책</a><a href="${pageContext.request.contextPath}/admin/processing-activities">처리업무</a><a class="active" aria-current="page" href="${pageContext.request.contextPath}/admin/templates">동의서 템플릿</a><span class="nav-group">시스템 관리</span><a href="${pageContext.request.contextPath}/admin/users">관리자 계정</a><a href="${pageContext.request.contextPath}/admin/roles">역할·권한</a><a href="${pageContext.request.contextPath}/admin/audit-events">감사 이력</a></nav>
<main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">CONSENT TEMPLATE</p><h1>동의서 템플릿</h1><p>승인된 처리업무를 기준으로 이메일과 웹에서 공유할 동의 내용을 관리합니다.</p></div><a class="primary-button" href="${pageContext.request.contextPath}/admin/templates/new">템플릿 등록</a></div>
<section class="work-panel"><form class="template-filter" method="get"><label>검색<input name="keyword" value="<c:out value='${keyword}'/>" placeholder="코드 또는 명칭"></label><label>상태<select name="status"><option value="">전체</option><option value="ACTIVE" ${selectedStatus == 'ACTIVE' ? 'selected' : ''}>사용</option><option value="INACTIVE" ${selectedStatus == 'INACTIVE' ? 'selected' : ''}>중지</option></select></label><button class="secondary-button" type="submit">조회</button></form>
<div class="table-scroll"><table class="data-table"><thead><tr><th>코드</th><th>템플릿 명칭</th><th>처리업무</th><th>발행 버전</th><th>최근 상태</th><th>사용 상태</th></tr></thead><tbody><c:forEach var="template" items="${templates}"><tr><td><a href="${pageContext.request.contextPath}/admin/templates/${template.consentTemplateId()}"><c:out value="${template.templateCode()}"/></a></td><td><c:out value="${template.templateName()}"/></td><td><c:out value="${template.processingActivityName()}"/></td><td><c:out value="${template.publishedVersionNumber()}" default="미발행"/></td><td><span class="template-state"><c:out value="${template.latestWorkflowStatus()}" default="-"/></span></td><td><c:out value="${template.templateStatus()}"/></td></tr></c:forEach><c:if test="${empty templates}"><tr><td colspan="6">조건에 맞는 동의서 템플릿이 없습니다.</td></tr></c:if></tbody></table></div></section></main></div></body></html>
