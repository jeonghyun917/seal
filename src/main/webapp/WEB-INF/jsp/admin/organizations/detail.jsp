<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>조직 상세</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"></head>
<body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">ORGANIZATION DETAIL</p><h1><c:out value="${organization.organizationName()}"/></h1><p><c:out value="${organization.organizationCode()}"/></p></div><div class="form-actions"><a class="secondary-button" href="${pageContext.request.contextPath}/admin/organizations">목록</a><a class="primary-button" href="${pageContext.request.contextPath}/admin/organizations/${organization.organizationUnitId()}/edit">수정</a></div></div>
<c:if test="${param.created != null}"><p class="alert alert-success">조직을 생성했습니다.</p></c:if><c:if test="${param.updated != null}"><p class="alert alert-success">조직 정보를 변경했습니다.</p></c:if>
<section class="work-panel"><h2>기본 정보</h2><dl class="detail-list"><div><dt>조직코드</dt><dd><c:out value="${organization.organizationCode()}"/></dd></div><div><dt>상위 조직</dt><dd><c:out value="${organization.parentOrganizationName()}" default="-"/></dd></div><div><dt>구분</dt><dd>${organization.rootUnit() ? '루트 조직' : '일반 조직'}</dd></div><div><dt>상태</dt><dd>${organization.active() ? '활성' : '비활성'}</dd></div></dl></section></main></div></body></html>
