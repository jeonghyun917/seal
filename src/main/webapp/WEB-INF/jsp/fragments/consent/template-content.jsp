<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<header><h1><c:out value="${preview.title()}"/></h1><p><c:out value="${preview.processingActivityName()}"/></p></header>
<section class="preview-introduction">${preview.introductionHtml()}</section>
<c:forEach var="item" items="${preview.items()}"><section class="preview-item"><div class="preview-item-head"><span>${item.required() ? '필수' : '선택'}</span><h2><c:out value="${item.title()}"/></h2></div><dl><div><dt>개인정보 항목</dt><dd><c:forEach var="name" items="${item.dataItemNames()}" varStatus="status"><c:if test="${!status.first}">, </c:if><c:out value="${name}"/></c:forEach></dd></div><div><dt>처리 목적</dt><dd><c:out value="${item.purpose()}"/></dd></div><div><dt>보유기간</dt><dd><c:out value="${item.retentionText()}"/></dd></div><c:if test="${not empty item.thirdPartyRecipient()}"><div><dt>제공받는 자</dt><dd><c:out value="${item.thirdPartyRecipient()}"/></dd></div></c:if><div><dt>거부 안내</dt><dd><c:out value="${item.refusalNotice()}"/></dd></div></dl><div class="decision-preview"><span>○ 동의</span><span>○ 미동의</span></div></section></c:forEach>
