<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${editing ? '동의서 양식 초안 편집' : '동의서 양식 등록'} | 개인정보 전자동의 관리시스템</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css?v=20260906-3"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/template.css?v=20260906-3"><script src="${pageContext.request.contextPath}/resources/js/template-form.js?v=20260906-1" defer></script><c:if test="${not editing}"><script src="${pageContext.request.contextPath}/resources/js/activity-picker.js?v=20260906-2" defer></script></c:if><script src="${pageContext.request.contextPath}/resources/js/simple-editor.js?v=20260906-1" defer></script></head>
<body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main">
<div class="page-heading-row"><div><p class="section-kicker">CONSENT FORM EDITOR</p><h1>${editing ? '동의서 양식 초안 편집' : '동의서 양식 등록'}</h1><p>보유기간과 개인정보 항목은 승인된 개인정보 이용 업무 원본을 기준으로 서버에서 다시 검증합니다.</p></div></div>
<c:set var="formAction" value="${editing ? pageContext.request.contextPath.concat('/admin/templates/').concat(templateId).concat('/versions/').concat(versionId) : pageContext.request.contextPath.concat('/admin/templates')}"/>
<form:form cssClass="template-editor" modelAttribute="templateForm" method="post" action="${formAction}"><form:hidden path="templateVersionNo"/><form:hidden path="contentVersionNo"/>
<section class="work-panel"><h2>기본 정보</h2><div class="template-grid"><label class="full-field">양식 관리 명칭<form:input path="templateName"/><small class="field-help">양식 코드는 등록 시 시스템에서 자동 생성됩니다.</small><form:errors path="templateName" cssClass="field-error"/></label></div>
<fieldset class="activity-picker-field"><legend>승인된 개인정보 이용 업무</legend><form:hidden path="processingActivityVersionId" id="processingActivityVersionId"/><div class="activity-selector-summary" id="activitySelectionSummary"><div><c:choose><c:when test="${not empty selectedActivity}"><strong id="selectedActivityName"><c:out value="${selectedActivity.activityName()}"/></strong><p id="selectedActivityMeta"><c:out value="${selectedActivity.activityCode()}"/> · <c:out value="${selectedActivity.retentionDisplayText()}"/></p><small id="selectedActivityPurpose"><c:out value="${selectedActivity.processingPurpose()}"/></small></c:when><c:otherwise><strong id="selectedActivityName">선택된 개인정보 이용 업무가 없습니다.</strong><p id="selectedActivityMeta">승인된 개인정보 이용 업무를 검색하여 선택해 주세요.</p><small id="selectedActivityPurpose"></small></c:otherwise></c:choose></div><c:if test="${not editing}"><button id="openActivityPicker" class="secondary-button" type="button">개인정보 이용 업무 선택</button></c:if></div><form:errors path="processingActivityVersionId" cssClass="field-error"/>
<c:if test="${not empty selectedActivity}"><div id="selectedActivitySeed" hidden data-activity-id="${selectedActivity.activityId()}" data-version-id="${selectedActivity.versionId()}"><span data-seed-code><c:out value="${selectedActivity.activityCode()}"/></span><span data-seed-name><c:out value="${selectedActivity.activityName()}"/></span><span data-seed-purpose><c:out value="${selectedActivity.processingPurpose()}"/></span><span data-seed-retention><c:out value="${selectedActivity.retentionDisplayText()}"/></span><c:forEach var="dataItem" items="${selectedActivity.dataItems()}"><span data-seed-data-item data-id="${dataItem.processingDataItemId()}" data-order="${dataItem.itemOrder()}" data-required="${dataItem.required()}"><c:out value="${dataItem.itemName()}"/></span></c:forEach></div></c:if>
<c:if test="${not editing}"><dialog id="activityPickerDialog" class="activity-picker-dialog" data-options-url="${pageContext.request.contextPath}/admin/templates/activity-options"><div class="activity-dialog-shell"><header><div><span>PROCESSING ACTIVITY SELECTOR</span><h2>승인된 개인정보 이용 업무 선택</h2><p>업무 이름·관리번호·이용 목적으로 검색하며 결과는 20건씩 표시됩니다.</p></div><button id="closeActivityPicker" class="dialog-close" type="button" aria-label="닫기">×</button></header><div class="activity-dialog-search"><input id="activitySearch" type="search" placeholder="업무 이름, 관리번호 또는 이용 목적 검색" aria-label="승인된 개인정보 이용 업무 검색"><button id="searchActivities" class="secondary-button" type="button">검색</button></div><div class="activity-dialog-status" id="activityResultStatus" aria-live="polite"></div><div id="activityResults" class="activity-results"><p class="activity-empty">개인정보 이용 업무를 불러오는 중입니다.</p></div><nav class="activity-pagination" aria-label="개인정보 이용 업무 검색 결과 페이지"><button id="previousActivityPage" type="button">이전</button><span id="activityPageLabel">1페이지</span><button id="nextActivityPage" type="button">다음</button></nav><footer><button id="cancelActivitySelection" class="secondary-button" type="button">취소</button><button id="applyActivitySelection" class="primary-button" type="button">선택 완료</button></footer></div></dialog></c:if></fieldset></section>
<section class="work-panel"><h2>안내문</h2><label>동의서 제목<form:input path="title"/><form:errors path="title" cssClass="field-error"/></label><div class="form-field"><label for="introductionHtml">안내문 내용</label><form:textarea path="introductionHtml" id="introductionHtml" rows="7" data-simple-editor="true"/><small class="field-help">문서처럼 입력하고 굵게·문단·목록 버튼으로 서식을 지정하세요. 수신자에게 표시될 내용입니다.</small><form:errors path="introductionHtml" cssClass="field-error"/></div></section>
<section class="work-panel"><div class="panel-title-row"><div><h2>동의 결정 항목</h2><p>각 항목마다 정보주체가 동의 또는 미동의를 선택합니다.</p></div><button class="secondary-button" id="add-consent-item" type="button">항목 추가</button></div><div id="consent-items"><c:forEach var="item" items="${templateForm.items}" varStatus="status"><article class="consent-item-card" data-consent-item><div class="item-card-head"><strong>동의 항목 <span data-item-number>${status.index + 1}</span></strong><button type="button" class="text-button" data-remove-item>삭제</button></div><div class="template-grid"><label>유형<form:select path="items[${status.index}].type"><form:option value="COLLECTION_USE">개인정보 수집·이용</form:option><form:option value="THIRD_PARTY_PROVISION">제3자 제공</form:option><form:option value="OPTIONAL">기타 선택 동의</form:option></form:select><form:errors path="items[${status.index}].type" cssClass="field-error"/></label><label>제목<form:input path="items[${status.index}].title"/><form:errors path="items[${status.index}].title" cssClass="field-error"/></label><label class="check-label"><form:checkbox path="items[${status.index}].required"/> 필수 동의<form:errors path="items[${status.index}].required" cssClass="field-error"/></label></div><label>개인정보 이용 목적<form:textarea path="items[${status.index}].purpose" rows="2"/><form:errors path="items[${status.index}].purpose" cssClass="field-error"/></label><label>보유기간 안내<form:input path="items[${status.index}].retentionText"/><form:errors path="items[${status.index}].retentionText" cssClass="field-error"/></label><label>거부권 안내<form:textarea path="items[${status.index}].refusalNotice" rows="2"/><form:errors path="items[${status.index}].refusalNotice" cssClass="field-error"/></label><label>제공받는 자(제3자 제공만)<form:input path="items[${status.index}].thirdPartyRecipient"/><form:errors path="items[${status.index}].thirdPartyRecipient" cssClass="field-error"/></label><fieldset><legend>개인정보 항목</legend><div class="processing-data-item-options" data-processing-data-items data-item-index="${status.index}"><c:choose><c:when test="${not empty selectedActivity.dataItems()}"><c:forEach var="dataItem" items="${selectedActivity.dataItems()}"><label class="check-label"><form:checkbox path="items[${status.index}].processingDataItemIds" value="${dataItem.processingDataItemId()}"/><c:out value="${dataItem.itemName()}"/><c:if test="${dataItem.required()}"><small>필수 항목</small></c:if></label></c:forEach></c:when><c:otherwise><p class="activity-empty">개인정보 이용 업무를 먼저 선택해 주세요.</p></c:otherwise></c:choose></div><form:errors path="items[${status.index}].processingDataItemIds" cssClass="field-error"/></fieldset></article></c:forEach></div><form:errors path="items" cssClass="field-error"/></section>
<div class="form-actions"><a class="secondary-button" href="${pageContext.request.contextPath}/admin/templates">취소</a><button class="primary-button" type="submit">${editing ? '초안 저장' : '동의서 양식 등록'}</button></div></form:form>
<template id="consent-item-template"><article class="consent-item-card" data-consent-item><div class="item-card-head"><strong>동의 항목 <span data-item-number></span></strong><button type="button" class="text-button" data-remove-item>삭제</button></div><div class="template-grid"><label>유형<select name="items[__INDEX__].type"><option value="COLLECTION_USE">개인정보 수집·이용</option><option value="THIRD_PARTY_PROVISION">제3자 제공</option><option value="OPTIONAL">기타 선택 동의</option></select></label><label>제목<input name="items[__INDEX__].title"></label><label class="check-label"><input type="checkbox" name="items[__INDEX__].required" value="true"> 필수 동의</label></div><label>개인정보 이용 목적<textarea name="items[__INDEX__].purpose" rows="2"></textarea></label><label>보유기간 안내<input name="items[__INDEX__].retentionText" value="보유정책에서 자동 적용"></label><label>거부권 안내<textarea name="items[__INDEX__].refusalNotice" rows="2"></textarea></label><label>제공받는 자<input name="items[__INDEX__].thirdPartyRecipient"></label><fieldset><legend>개인정보 항목</legend><div class="processing-data-item-options" data-processing-data-items data-item-index="__INDEX__"><c:choose><c:when test="${not empty selectedActivity.dataItems()}"><c:forEach var="dataItem" items="${selectedActivity.dataItems()}"><label class="check-label"><input type="checkbox" name="items[__INDEX__].processingDataItemIds" value="${dataItem.processingDataItemId()}"><c:out value="${dataItem.itemName()}"/><c:if test="${dataItem.required()}"><small>필수 항목</small></c:if></label></c:forEach></c:when><c:otherwise><p class="activity-empty">개인정보 이용 업무를 먼저 선택해 주세요.</p></c:otherwise></c:choose></div></fieldset></article></template>
</main></div></body></html>
