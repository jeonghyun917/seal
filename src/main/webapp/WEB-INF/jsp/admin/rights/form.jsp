<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>권리요청 접수</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"></head><body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">NEW RIGHTS REQUEST</p><h1>권리요청 접수</h1><p>본인확인은 접수 후 별도 단계에서 기록합니다.</p></div><a class="secondary-button" href="${pageContext.request.contextPath}/admin/rights">취소</a></div>
<form:form class="work-panel data-form" method="post" action="${pageContext.request.contextPath}/admin/rights" modelAttribute="rightsRequestForm">
<form:errors path="*" cssClass="alert alert-error full-field" element="div"/>
<label>대상자<form:select path="recipientId" required="required"><form:option value="">선택하세요</form:option><c:forEach var="recipient" items="${recipients}"><form:option value="${recipient.recipientId()}">${recipient.maskedName()} · ${recipient.maskedEmail()}</form:option></c:forEach></form:select></label>
<label>동의요청<form:select path="consentRequestId"><form:option value="">선택 안 함</form:option><c:forEach var="request" items="${consentRequests}"><form:option value="${request.requestId()}">${request.requestCode()} · ${request.status()}</form:option></c:forEach></form:select><span class="field-help">삭제·처리제한·동의철회 유형은 필수입니다.</span></label>
<label>유형<form:select path="type" required="required"><form:option value="ACCESS">열람</form:option><form:option value="CORRECTION">정정</form:option><form:option value="ERASURE">삭제</form:option><form:option value="RESTRICTION">처리제한</form:option><form:option value="WITHDRAWAL">동의철회</form:option></form:select></label>
<label>접수일<form:input type="date" path="receivedDate" required="required"/></label>
<label>처리기한<form:input type="date" path="dueDate" required="required"/></label>
<label class="full-field">요청 상세<form:textarea path="detail" required="required" maxlength="2000" rows="8"/></label>
<div class="form-actions"><button class="primary-button" type="submit">접수</button></div>
</form:form></main></div></body></html>
