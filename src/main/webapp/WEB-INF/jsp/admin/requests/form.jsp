<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${editing ? '동의 요청 수정' : '동의 요청 생성'}</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/recipient-request.css"></head><body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main"><div class="page-heading-row"><div><p class="section-kicker">CONSENT REQUEST</p><h1>${editing ? '동의 요청 수정' : '동의 요청 생성'}</h1><p>활성 대상자와 현재 발행된 동의서 템플릿을 선택합니다.</p></div></div>
<c:set var="formAction" value="${editing ? pageContext.request.contextPath.concat('/admin/requests/').concat(requestId) : pageContext.request.contextPath.concat('/admin/requests')}"/>
<section class="work-panel"><form:form method="post" action="${formAction}" modelAttribute="requestForm" cssClass="data-form"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><form:hidden path="idempotencyKey"/><form:hidden path="versionNo"/>
<div class="form-field"><form:label path="recipientId">동의 대상자</form:label><form:select path="recipientId"><form:option value="" label="선택"/><c:forEach var="recipient" items="${recipients}"><form:option value="${recipient.recipientId()}" label="${recipient.maskedName()} · ${recipient.maskedEmail()}"/></c:forEach></form:select><form:errors path="recipientId" cssClass="field-error"/></div>
<div class="form-field"><form:label path="templateVersionId">발행 템플릿</form:label><form:select path="templateVersionId"><form:option value="" label="선택"/><c:forEach var="template" items="${templates}"><form:option value="${template.templateVersionId()}" label="${template.templateCode()} · ${template.templateName()} v${template.versionNumber()}"/></c:forEach></form:select><form:errors path="templateVersionId" cssClass="field-error"/></div>
<div class="form-field"><form:label path="expiresAt">응답 만료일시</form:label><form:input path="expiresAt" type="datetime-local"/><form:errors path="expiresAt" cssClass="field-error"/></div><div class="form-actions"><a class="secondary-button" href="${pageContext.request.contextPath}/admin/requests">취소</a><button class="primary-button">${editing ? '초안 저장' : '초안 생성'}</button></div></form:form></section></main></div></body></html>
