<%@ taglib prefix="seal" uri="https://arte.or.kr/seal/functions" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>동의서 양식 상세 | 개인정보 전자동의 관리시스템</title><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/admin-data.css?v=20260906-3"><link rel="stylesheet" href="${pageContext.request.contextPath}/resources/css/template.css?v=20260906-3"></head><body class="admin-body"><jsp:include page="/WEB-INF/jsp/fragments/admin/header.jsp"/><div class="admin-layout"><jsp:include page="/WEB-INF/jsp/fragments/admin/sidebar.jsp"/><main class="admin-main">
<div class="page-heading-row"><div><p class="section-kicker">TEMPLATE DETAIL</p><h1><c:out value="${template.templateName()}"/></h1><p><c:out value="${template.templateCode()}"/> · <c:out value="${template.processingActivityName()}"/></p></div><span class="status-badge"><c:out value="${seal:statusLabel('template', template.templateStatus())}"/></span></div>
<c:if test="${not empty conflictMessage}"><p class="field-error"><c:out value="${conflictMessage}"/> 최신 상태를 기준으로 다시 시도해 주세요.</p></c:if><c:if test="${param.created != null}"><p class="success-message">동의서 양식 초안이 생성되었습니다.</p></c:if><c:if test="${param.published != null}"><p class="success-message">승인 버전이 발행되었습니다.</p></c:if>
<section class="work-panel"><div class="panel-title-row"><div><h2>버전 이력</h2><p>발행 버전은 수정하지 않고 새 초안으로 복제합니다.</p></div></div><div class="table-scroll"><table class="data-table"><thead><tr><th>버전</th><th>제목</th><th>상태</th><th>작성자</th><th>승인자</th><th>작업</th></tr></thead><tbody><c:forEach var="version" items="${template.versions()}"><tr><td>v<c:out value="${version.versionNumber()}"/></td><td><c:out value="${version.title()}"/></td><td><span class="template-state"><c:out value="${seal:statusLabel('workflow', version.workflowStatus())}"/></span></td><td><c:out value="${version.createdByName()}"/></td><td><c:out value="${version.approvedByName()}" default="-"/></td><td class="action-cell"><a href="${pageContext.request.contextPath}/admin/templates/${template.consentTemplateId()}/versions/${version.consentTemplateVersionId()}">상세보기</a><a href="${pageContext.request.contextPath}/admin/templates/${template.consentTemplateId()}/versions/${version.consentTemplateVersionId()}/preview">화면 미리보기</a><c:if test="${version.workflowStatus() == 'DRAFT'}"><a href="${pageContext.request.contextPath}/admin/templates/${template.consentTemplateId()}/versions/${version.consentTemplateVersionId()}/edit">편집</a><form method="post" action="${pageContext.request.contextPath}/admin/templates/${template.consentTemplateId()}/versions/${version.consentTemplateVersionId()}/request-review"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button type="submit">검토 요청</button></form></c:if><c:if test="${version.workflowStatus() == 'REVIEW_REQUESTED'}"><form method="post" action="${pageContext.request.contextPath}/admin/templates/${template.consentTemplateId()}/versions/${version.consentTemplateVersionId()}/approve"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button type="submit">승인</button></form><form method="post" action="${pageContext.request.contextPath}/admin/templates/${template.consentTemplateId()}/versions/${version.consentTemplateVersionId()}/reject"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input name="comment" required maxlength="1000" placeholder="반려 의견"><button type="submit">반려</button></form></c:if><c:if test="${version.workflowStatus() == 'APPROVED'}"><form method="post" action="${pageContext.request.contextPath}/admin/templates/${template.consentTemplateId()}/versions/${version.consentTemplateVersionId()}/publish"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button type="submit">발행</button></form></c:if><c:if test="${version.workflowStatus() == 'PUBLISHED' || version.workflowStatus() == 'RETIRED'}"><form method="post" action="${pageContext.request.contextPath}/admin/templates/${template.consentTemplateId()}/versions"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="sourceVersionId" value="${version.consentTemplateVersionId()}"><button type="submit">새 초안 복제</button></form></c:if></td></tr></c:forEach></tbody></table></div></section>
<section class="work-panel compact-panel"><h2>동의서 양식 사용 상태</h2><form method="post" action="${pageContext.request.contextPath}/admin/templates/${template.consentTemplateId()}/status"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="versionNo" value="${template.versionNo()}"><select name="status"><option value="ACTIVE">사용</option><option value="INACTIVE">중지</option></select><button class="secondary-button" type="submit">상태 변경</button></form></section></main></div></body></html>
